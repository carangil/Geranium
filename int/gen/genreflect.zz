type @typeT Type
	@typeT_name	name:String cpointer;
	@typeT_size	size:N32;
	@typeT_category	category:N32;
	@typeT_ref	ref:Type&;
	@typeT_len	len:N32;
	@typeT_isPer	isPer:Bit;
end
primitive C_findType findType:(category:Z32; ref:Type&; name:String&; size:Z32->Type&);
primitive C_printTypeNoRedirect printTypeNoRedirect:(c_ty:Type&; c_line:Bit; c_skipmembers:Bit-> );
primitive C_testComputeShader testComputeShader:(-> );
primitive C_type_member []:(ty:Type&; n:N32 -> Type&);

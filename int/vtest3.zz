[spair%] 10 new #table



proc Get:( pi:[pair%]&  ; k:Hashkey& -> like pi[].value)

    newline "get start" print newline newline
    pi 0[] keep #p
    
    p printptr newline
    
    loop 
        "p " print   p printptr newline
        p :Bit  while
        
        "key " p.key :String& prints newline
        
        p.key k == if
            p.value keep return
        end
        
        p.next keep p =
    
       
    end
    
    null return
end





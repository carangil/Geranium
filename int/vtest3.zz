//need a hashmap


virtual Hashkey;
selector h proc .hash:(h:Hashkey& -> N32);
selector h proc copy:(h:Hashkey& -> like h @ % );
selector h proc ==:(h:Hashkey& ; h2: like h->Bit);

type String
    virtual hk:Hashkey;
end

virtual pair;
selector pair.value:any%;
//selector pair.value:hvalue%;
//selector pair.key:String%;
selector pair.key:Hashkey%;
selector pair.next:pair%;
selector pair.nextG:pair%;
selector pair.testfp:(p:pair%);
//selector pair.TEST:Z32%;

type spair
    key:String%;
    value:String%;
    next: spair%;
    nextG:pair%;
    testfp:(p:spair%; a:Z32);
    
    virtual p:pair;
    //TEST:Z32%;
end

type ipair
    key:String%;
    value:Z32%;
    nextG:pair%;
    next: spair%;
    virtual p:pair;
end


virtual Printer;
selector p Print:(a:Z32; p:Printer% -> like p@%);



var z:Z32;


type [spair%]
    virtual p:Printer;
end

proc Print:(a:Z32 ; x:[spair%]%->like x@%)

    a print
    x take return
end



proc  GetFromBucket:(  pi:pair% ; k:Hashkey& -> like pi.value )
  
  pi take #p
  
    
//  "looking for " k prints newline
  
  loop
    
    p:Bit while
    
   // "-" p.key prints newline
    
    
    "P  " print p printptr newline
    "p& " print p& printptr newline
    
    
    "P NEXT" print p.next printptr newline
    
    "P NEXT&" print p.next& printptr newline
    
    
    
    
    "P VALUE" print p.value printptr newline
    "P KEY"  print p.key printptr newline
    
    
    
    p.key 
    
    k == if
        "match" print newline
        p    .value keep return
    else
        "continue" print newline
    end
       
    "p.key: " print p.key printptr newline
    
    p //~
    .next 
    keep 
    p
    =
  
  end
  
  null return
  
end


proc  PutInBucket:(   v: like pi.value;    pi:pair% ; k:Hashkey& -> like pi )
  
  pi keep #p
  
  "PUT. start with p as " print    p printptr  newline
   
    
  //"looking for " k "to insert" prints newline
  
  loop
    
    p:Bit while
      
      "PUT. loop start with p as " print    p printptr  newline
    
    
    p.key k == if
    
    
        "match.. time to write" print newline
 
       v take p.value =
        
        pi take return
        
        
    else
        "continue" print newline
    end
           
    "PUT. p next " print    p.next printptr  newline
    
    p.next keep p=
  
  end
  
  
  
  "NEW ITEM" print newline
 
  
  pi dtypeof new p=
  
  p:any& printptr
  

  
  "p.next" print
  p.next   printptr newline
    
  "set v value" print newline
  v take p.value= 
 
  "copy  " print k copy ##jjj printptr newline
 
    //loop end
    
    
    
    
  k copy p.key=
 
 
  "p is " print
  p:any& printptr newline
  
  "p.next" print
  p.next  any& printptr newline
  
 
  pi  take  p.next  =
  
 // "not in bucket: todo insert " k     prints newline
  
  p take return
    
  //pi dtypeof new
  //pi typeof " "  pi dtypeof print newline
  
end


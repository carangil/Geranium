type aaaa
	a:Z32%;
	b:Z32%;
end

proc ffff:(->)
	var zstatic:[2 Z32%];
	var v:aaaa;

	Z32 new zstatic 0 []=  //these are not freed (TODO: bug!)
	Z32 new zstatic 1 []= 
	
	
	Z32 new v.a=	//these are freed
	Z32 new v.b=
	
	return
end

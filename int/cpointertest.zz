"base/base.zz" include




type bigptr
	a:String%;
	b:String%;
end

var big:bigptr;

"big0" strdup big.a=
"big1" strdup big.b=

big :any& print newline
big.a& :any& print newline
big.b& :any& print newline
big.a print newline
big.b print newline
newline




//opaque CString;

type littleptr
	a: String cpointer;
	b: String cpointer;
end

var little:littleptr;

"little0"  little.a=
"little1"  little.b=

little :any& print newline
little.a&:any& print newline
little.b&:any& print newline

little.a  print newline
little.b  print newline


var lp:littleptr cpointer;
var lp2:String cpointer;

"boo" lp2= 
little lp=

lp.a print newline
lp.b print newline
lp2 print newline





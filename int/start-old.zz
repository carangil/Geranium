type LL
	head:LN%;
	tail:LN%;
	
end


type LN
	next:LN%;
	prev:LN%;
	name:String%;
end



proc destructor:(a:LL&)	
	a.head take #ln			//no ref count update
	loop ln:Bit while
		ln.prev take trash//switch with above!
		ln.next take ln=
	end
end


virtual Term;
selector t print:(t:Term&);

virtual UTerm;
selector UTerm.a:Term%;
selector UTerm.term:Term%;

virtual BinTerm;
selector BinTerm.a:Term%;
selector BinTerm.b:Term%;
selector BinTerm.term:Term;	//binterm is also a term



type IntegerTerm
	i:Z32;
	t:Term;
end
proc print:(t:IntegerTerm&)
	t.i print
end


type AddTerm
	a:Term%;
	b:Term%;
	binterm:BinTerm;
	term:Term;
end
proc print:(t:AddTerm&)
	"( " t.a  " + "  t.b  " )" prints
end

//AddTerm new :BinTerm% #bt



proc :Term:(a:Z32->Term%)
	IntegerTerm new #it
	a it.i=
	it take :Term% return
end



proc +:(a:Term%;b:Term%->Term%)
	AddTerm new #t
	a take t.a=
	b take t.b=
	t take:Term% return

end



"base/base.zz" include
"gen.zz" include


immediate
    2 #category_reference
    8 #category_possessive
    5 #category_array
end

proc arrayof:(t:Type&->Type&)
    category_array t 0:String& 0 ZFindType return
end

proc .@:(t:Type&->Type&)
    t.ref return
end

proc .&:(t:Type&->Type&)
    category_reference t 0:String& 0 ZFindType return
end

proc .%:(t:Type&->Type&)
    category_possessive t 0:String& 0 ZFindType return
end

proc print:(t:Type&->)
	t 0:Bit 0:Bit printTypeNoRedirect
end

proc immediate bake:(t:Type&->Type&)
	t return
end

primitive ptrequal ==:(a:Type&;b:Type&->Bit);

proc immediate mkarray:(t:Type&; n:N32 ->Code% )


	"in mkarray" print newline
	t arrayof #atype
	n 1 + #x
	
	
	
	
	
	t N32 == if 
		"array is of type N32" print newline
	t Z32 == elseif
		"array is of type Z32" print newline
	else
		"array is something else" print newline
	end
	
	
	code\
		$atype $x  new
	\ return
	
end



"to mkarray" print newline
N32 200 mkarray #na
Z32 100 mkarray #za

na typeof.@ print
na size print newline

za typeof.@ print 
za size print newline

"done array" print newline


proc immediate add:(code a:Z32;code b:Z32->Code%)
	code \
		'a 'b +
	\ return
end

proc ftest:(aa:Z32;bb:Z32)

	

	aa aa+  bb add print newline


end
22 33 ftest

proc immediate f2:(a:Z32 ->   Code% )
	"in f2\n" print newline
	
	code \
		'a print
		'a print
	\ return
	
end




proc f2t:(a:Z32)
	
	code \ 10 \ #b
	code \ $a \ #c
	code \ + \  #d
	
	code (->Z32) \ 'b 'c 'd return \ #bcd
	
	bcd print newline

end

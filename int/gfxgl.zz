end

virtual Exp;
selector Exp.text:String%;
selector Exp.type:Type&;
selector Exp.args:[Exp%]%;
selector ex Write:(ex:Exp&; top:Bit; ->String% );

type GLSLAddressing //for struct members or array indexing
    text:String%;
    type:Type&;
    args:[Exp%]%;  //args that might have been used at compile time to generate this leaf node... not used at runtime
    exp:Exp;
end


proc Write:(exp:GLSLAddressing&;top:Bit ->String%)
    
    "Write for " exp typeof prints newline
    
    
    "IN WRITE ---------------------------" print newline
 //   loop end
    
    exp.args not 
    exp.args.count 1 != or  if
        "Must access off something" print newline
        "" copy return
    end
    
    "to write args0" print newline
    
    exp.args 0[] false Write 
    
    exp.text ++
    
    
    return
end




type GLSLTerm
    text:String%;
    type:Type&;
    args:[Exp%]%; //are not printed 
    nosemi:Bit; //no semicolon, even if at top level
    exp:Exp;
end

proc Write:(exp:GLSLTerm&;top:Bit ->String%)
    
    "Write for " exp typeof prints newline
    
    
    top 
    exp.nosemi not and if 
        ";S" LF ++ #ending
    end
    
    

    exp.args.count 1 == if
        exp.args 0[] false Write ending ++ return
    end
    
    
    exp.text copy ending ++ return
    
    
end

type GLSLBinop
    text:String%;
    args:[Exp%]%;
    type:Type&;
    noParen:Bit;
    
    exp:Exp;
    
end

proc Write:(exp:GLSLBinop&;top:Bit ->String%)
    
    "Write for " exp typeof prints newline
    
    
    top if
        ";" copy #ending
       
    end
    
    exp.noParen if
        "" copy         #Popen
        ""            #Pclose
    else
        "(" copy        Popen=
        ")"             Pclose=
    end
    
    Popen take
    exp.args 0[] false Write ++
    
    exp.text ++
    
    exp.args 1[] false Write ++
    Pclose ++ 
    ending ++ 
    
    return

end
  
type GLSLFuncOp
    text:String%;
    args:[Exp%]%;
    type:Type&;
    exp:Exp;
end

type GLSLBlock
    text:String%;
    args:[Exp%]%;   //if, else if, and else blocks  (maybe while too)
    type:Type&;
    exp:Exp;
end

proc Write:(exp:GLSLBlock&; top:Bit ->String%)
   
    "Write for " exp typeof prints newline
    
    
    exp.text copy #s
    s take " (" ++ s=
    s take exp.args 0[] false Write ++ s=
    s take ") {" ++ LF ++ s=            
    
    1 #i loop i exp.args.count < while
        
        s take exp.args i[] true Write ++ LF ++ s=
        
        
        i&++
    
    end
       
    
    s take "}" ++ LF ++ s=
    
    
    s take return
end

type GLSLIfChain
    text:String%;
    args:[Exp%]%;   //list of statements
    type:Type&;
    exp:Exp;
end

proc Write:(exp:GLSLIfChain&;top:Bit ->String%)
    
    "Write for " exp typeof prints newline
    
    
    "" copy #s
   
    var isOpen:Bit;
    
    0 #i loop i exp.args.count < while
        
        
        i 1 >= if 
        
                exp.args i[] :GLSLBlock& if
                    s take " else " ++ s =
                    
                isOpen not elseif
                
                    s take " else {" ++ LF ++ s =  //the final else clause
                    true isOpen=
                                
                end
        
        end
        
                
        s take exp.args i[] true Write  ++  s=
                
        
        i&++
    
    end
    
    isOpen if
        s take "}" ++ s=    
    end
    
    
    s take return
end

proc Write:(exp:GLSLFuncOp& ;top:Bit->String%)

    "Write for " exp typeof prints newline
    


    exp.text copy "(" ++ #s
    
    0#i loop i exp.args  .count < while
    
        i 0 > if 
            s take ", " ++ s=
        end
            
        s take exp.args i[] false Write ++ s=
        
        i&++
    end
    
    s take ")" ++ s=
    
    
    top if 
        s take ";" ++ s=
    end
    
    s take
    return
    
end


type gmapping
    symbol: Symbol;
    type:   Type&;
    glsl:   String%;
    next:  gmapping%;
end

var GLSLMapping:gmapping%;

proc GLSLAddFunc : (s:Symbol; name:String&)
    
    gmapping new #gm 
    
    s gm.symbol=
    name copy gm.glsl=
    GLSLMapping take gm.next=
    gm take GLSLMapping=
end


proc GLSLAddType : (t:Type&; name:String&)
    
    gmapping new #gm 
    
    t gm.type=
    name copy gm.glsl=
    GLSLMapping take gm.next=
    gm take GLSLMapping=
end




proc LookupFunction:(s:Symbol->String%)
    GLSLMapping keep #gm
    loop gm:Bit while
    

        gm.symbol s == if
           
            gm.glsl copy return
        end
    
        gm.next keep gm=
    end
    0:String% return
end


proc LookupType:(t:Type&->String%)
    GLSLMapping keep #gm
    loop gm:Bit while
    
        gm.type t == if
            gm.glsl copy return
        end
    
        gm.next keep gm=
    end
    0:String% return
end



proto :Vec4:(v:Vec3;a:Real->Vec4);


                Real    Real:Vec2 noexec "vec2" GLSLAddFunc
        Real    Real    Real:Vec3 noexec "vec3" GLSLAddFunc
                Vec3    Real:Vec4 noexec "vec4" GLSLAddFunc
Real    Real    Real    Real:Vec4 noexec "vec4" GLSLAddFunc
    

    
type GLSLDecompiler
    //for printing
	indentLevel:Z32;
		
	curargs:[Exp%]%;
		
	dc:Decompiler;
end


proc Indent:(n: N32)
 newline   
    0#i
    loop i n < while
        " " print
        i&++
    end

end

proc Indent:(dc: GLSLDecompiler&)
    dc.indentLevel Indent
end


proc Dump:(t:ExecToken)

    t.prim  " \"" t.text "\"" prints
    t.consttype String& ==
	t.consttype String% == or if
		" " t.value:String& " " prints
	t.consttype Real == elseif
		" Real " t.value:Real " " prints
	else
		" " t.value:Z32 " " prints
	end

    t.evaltype:Bit if
        " produces " t.evaltype prints
    end

end






proto End:(dc: GLSLDecompiler& ; t:ExecToken);


proc Begin:(dc: GLSLDecompiler& ; t:ExecToken; subcount:N32)
    dc Indent  t.prim " '" t.text "'" "{" prints newline

    t:Bit not if
        "null token" print loop end
    end
    
	dc.indentLevel&++

    var exp:Exp%;
    var subexp:[Exp%]%;
    
    "save args" print newline
    dc.curargs take #saveArgs
 
    
    subcount 0 > if                //allocate space for args
        [Exp%] subcount new0 subexp=     
        subexp take dc.curargs=
    end
    
    
    t.prim "local" ==
    t.prim "perarg" == or
    t.prim "constant" == or   if
        t.prim "(local/perarg/varname)" t.text prints
        GLSLTerm new:Exp% exp=
        t.text copy exp.text=

        
    t.prim "stackptr" == elseif   //only valid in some specific instances
     "  (stackPOINTE varname)" t.sub.text prints newline
        GLSLTerm new:Exp% exp=
        t.sub.text copy exp.text=
   
        
    
    t.prim "stackread" == elseif
     "  (stackread varname)" t.sub.text prints newline
        GLSLTerm new:Exp% exp=
        t.sub.text copy exp.text=
        
        //t.text:Bit if " text " print end
    
    t.text "@" == elseif //load function
    
        GLSLTerm new:Exp% exp=
        "go into @" print newline
        dc:Decompiler& t.sub decompile
        "back to @" print newline
        
        dc.curargs:Bit if
            "got value " dc.curargs 0[].text prints newline
            //dc.curargs 0[].text copy exp.text=
            dc.curargs take exp.args=
        else
            "no value" print newline
            loop end
       end
        
               
    t.text "=" ==    elseif     //assignment... args in opposite order than other binop nodes
    
        GLSLBinop new ##bin keep :Exp% exp=
        true bin.noParen=   //no parenthesis
      
        t.text copy exp.text=
        
        "into dest" print newline
        
        dc:Decompiler& t.sub.next   decompile1
        
        "into source" print newline
        dc:Decompiler& t.sub        decompile1
        dc.curargs take  exp.args=
        
    
    
    //functions and primitives named like infix operators are treated as such.
    t.text "=" == 
    t.text ">" == or
    t.text ">=" == or
    t.text "<" == or
    t.text "<=" == or
    t.text "==" == or
    t.text "!=" == or
    t.text "+" == or
    t.text "-" == or
    t.text "*" == or
    t.text "/" == or elseif
    
            
        GLSLBinop new:Exp% exp=
        t.text copy exp.text=
        dc:Decompiler& t.sub        decompile1
        dc:Decompiler& t.sub.next   decompile1
        dc.curargs take  exp.args=
      
      
      //simple IF
    t.prim "condblock" == elseif
        
        GLSLBlock new:Exp% exp=
        
        "if" copy exp.text=
    
        t.sub 3 Z32 Indent& disassemble
    
        dc:Decompiler& t.sub decompile  //decompile the if block

        dc.curargs take exp.args=
              
    t.prim "ifchain" == elseif
    
        GLSLIfChain new:Exp% exp=
            
    
        t.sub #tif
        
        dc:Decompiler& tif decompile
        
        dc.curargs take exp.args=
        
        
    t.prim "offsetptr" == elseif
    
    
        GLSLAddressing new:Exp% exp=


        dc:Decompiler&   t.sub decompile1  //do 1 arg

        
        //"OFFSET" copy exp.text=
        t.text copy exp.text=

       // dc.curargs 0[].text copy t.text ++ exp.text=
       
        dc.curargs take exp.args=
        

        
    
    t.text "end" == 
    t.prim "nop" == or elseif
    
        "nop" print newline
        //nothing
    
    
    t.text "_GLSLRAW" == elseif
    
    
    
        GLSLTerm new ##term keep:Exp% exp=
        true term.nosemi=
        t.sub.value:String& copy exp.text=
    
    
    
    

    t.sub:Bit elseif  //treat as function call
            
        GLSLFuncOp new:Exp% exp=
    
        t.symbol LookupFunction #fname

        fname:Bit if
            fname copy exp.text=
            "using name "fname prints newline
        else
            "/*auto*/ " copy t.text ++ exp.text=
        end
        
        dc:Decompiler& t.sub decompile
        dc.curargs take exp.args=
         
    else
        dc Indent "TODO: '" t.text "' " t.prim prints
        t 1 Z32 Indent& disassemble
        loop end
    end
    
    
    
    
   "done decompile on " t.prim " " t.text prints newline
    
    
    
    dc Indent "restore args" print newline
    saveArgs take dc.curargs=  //put args back
    
    
    
    exp:Bit if
        "adding arg" print newline
        
        dc.curargs:Bit not if
            [Exp%] 8 new0 dc.curargs=   //create
        end
    
        dc Indent "putting arg " dc.curargs.count " / " dc.curargs.size  prints newline
    
        exp take dc.curargs& push
    
    end
  
       
    "end decomp" print newline
       

	
end


proc End:(dc: GLSLDecompiler& ; t:ExecToken)
    dc.indentLevel&--
//    dc Indent "}" print 
	//t Dump
end

 
   

proc dsym:(s:Symbol)
    
    
    
    s.tokens 1 Z32 Indent& disassemble
    
    
    GLSLDecompiler new #decomp
    
    newline
    "symbol type: " print
    s.type print newline
    
    decomp:Decompiler&   s.tokens decompile //s.tokens decompile 

    newline newline
    
    decomp.curargs :Bit not if
        "//no statements" print newline
        return
    
    end
        
    0#i loop i decomp.curargs.count < while
    
    
        decomp.curargs i [] true Write ##g prints newline
        i&++
    end
    
    loop end
    
    return
    
end



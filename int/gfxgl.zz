proc immediate mkprints:(typename:String&  -> Code%)

    "'" #'

    code \\
        
        proc immediate prints:(code a: 'typename  ->Code%)

            "returning prints code" print newline 
            code \
    
                 prints ''a print
        
            \ return

        end


    \\return

end


"Z32"     mkprints
"Real"    mkprints
"String&" mkprints
"N8"      mkprints


type Sprite
    style:Style%;
    left:Z32;
    top:Z32;
    width:Z32;
    height:Z32;
    pw:Z32;
    ph:Z32;
    
    
end

var window:ZWindow;

proc pix:(x:Z32;w:Z32->Real)
    x.Real  w.Real / return
    
end


6.28318 #TAU






proc Draw:(sprite:Sprite& ; x:Real; y:Real; w:Real; h:Real ; angle:Real ->)


    proc RotXY:(x:Real&;y:Real&;angle:Real->)

        angle  cos x@*
        angle  sin y@ * - #nx

        angle  sin x@*
        angle  cos y@*  + y@=

                                    nx x@=
        
        return
            

    end



    window  "position:3|texcoord:2" TempVBuffer 
     #vb
   
                                                                sprite.style UseStyle
                                                                sprite.left sprite.width  +  #sprite_right
                                                                sprite.top  sprite.height +  #sprite_bottom
     
      
          w 0.5* negative #xx   h 0.5* negative #yy                               
                           xx&                   yy& angle RotXY
       vb  0            x  xx+                y  yy+               0.0  Data 
       vb  1                                                       sprite.left sprite.pw pix     sprite.top sprite.ph pix    Done          
      
      
      
      
      
          w 0.5*           xx=  h 0.5* negative  yy=                              
                           xx&                   yy& angle RotXY
       vb  0            x  xx+                y  yy+               0.0  Data 
       vb  1                                                       sprite_right sprite.pw pix    sprite.top sprite.ph pix    Done          
      
      
      
          w 0.5*           xx=  h 0.5*           yy=                              
                           xx&                   yy& angle RotXY
       vb  0            x  xx+                y  yy+               0.0  Data 
       vb  1                                                       sprite_right sprite.pw pix    sprite_bottom sprite.ph pix    Done          
      
                                        
                                        
                                        
    
          w 0.5* negative  xx=  h 0.5*           yy=                              
                           xx&                   yy& angle RotXY
       vb  0            x  xx+                y  yy+               0.0  Data 
       vb  1                                                       sprite.left sprite.pw pix    sprite_bottom sprite.ph pix    Done          
    
    
                        
            
            
     //   vb   0  x w 0.5* -     y h 0.5* -  0.0  Data vb 1     sprite.left sprite.pw pix   sprite.top sprite.ph pix    Done       
        //vb   0  x w 0.5* +     y h 0.5* -  0.0  Data vb 1     sprite_right sprite.pw pix   sprite.top sprite.ph pix    Done    
        ///vb   0  x w 0.5* +     y h 0.5* +  0.0  Data vb 1     sprite_right sprite.pw pix   sprite_bottom sprite.ph pix Done  
      //  vb   0  x w 0.5* -     y h 0.5* +  0.0  Data vb 1     sprite.left sprite.pw pix    sprite_bottom sprite.ph pix Done  
        vb GFX_QUAD DrawReset
 
      // angle 1.0 + angle=
//    sprite.style UseStyle
//        vb   0  x        y      0.0  Data vb 1     sprite.left sprite.pw pix    sprite.top sprite.ph pix  Done         
//        vb   0  x w+     y      0.0  Data vb 1     sprite_right sprite.pw pix   sprite.top sprite.ph pix  Done  
//        vb   0  x w+     y h +  0.0  Data vb 1     sprite_right sprite.pw pix   sprite_bottom sprite.ph pix  Done  
//        vb   0  x        y h +  0.0  Data vb 1     sprite.left sprite.pw pix    sprite_bottom sprite.ph pix  Done  
//    vb GFX_QUAD DrawReset
  
  
  
    return
end


proc LoadSprite:(filename:String&; left:Z32; top:Z32; w:Z32; h:Z32; imgw:Z32; imgh:Z32 ->Sprite%)


    MkStyle #style
    filename ZTGA_TOP BitmapLoadTGA #image
    image CreateTexture #texture
    texture GFX_TEXTURE_SCALER_BLOCKY Scaler
    
    style GFX_TEXTURE "texture_diffuse" 0 0 texture:Void 0 Set
    style 0            "blend" 0 GFX_BLEND_ALPHA 0:Void 0 Set

    Sprite new #s
    
    style take s.style=
    left s.left=
    top s.top=
    w s.width=
    h s.height=
    imgw s.pw=
    imgh s.ph=

    s take return
end


//create an opengl window
"Z Window " 1024 768 0 GLWindow window=

var ev:ZEvent;


    


0.0 0.0 0.1 1.1 BackgroundColor

//left right top bottom
0.0 1024.0 0.0 768.0  Setup2D

window  "color:4|position:3|texcoord:2" TempVBuffer #vb


"asteroids/ship.tga" 0 0 64 64 64 64 LoadSprite #ship

0.0 #angle
    
loop

    loop
        
        window ev GetEvent  not if break end
        "Event " print ev.eventType print newline
        
        ev.eventType ZEVENT_WINDOWSIZE == if 
            //90.0   ev.A.Real ev.B.Real/  0.1   1000.0 Setup3D 
            ev.A print " " print ev.B print " <- resize \n" print
        end
    end
    
    ev.eventType ZEVENT_CLOSE == if 
        "Closing window" print newline
        window zw_close
        break
    end

  //  0.001 gfx_rotate_z
   
    
    1:Bit 1:Bit FrameClear
    
    
    
    ship 600.0 300.0 64.0 64.0  angle Draw
    angle 0.01+angle=
    window UpdatePixels

end

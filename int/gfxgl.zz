//compile a shader with inline GLSL source
proc  testVertexShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real&;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		extra: Vec4&;
		per texcoord:	[Vec2]&;
		
		
		->GLSLDrawProc)
		
	"
		in vec4 point;
		#if MASK_color
		in vec4 color;
		#endif
		
		uniform vec4 extra;
		uniform mat4 projection;
		uniform mat4 modelView;
		uniform vec4 testu[8];
		uniform float offset;
		in vec2 texcoord;
		out vec2 f_texcoord;
		out vec4 f_color;
		out vec4 f_extra;
		
		void main(){
			vec4 transformed = modelView * vec4(point.x+offset, point.y, point.z +testu[3].y, 1.0);
			//vec4 transformed = modelView * point;
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
            
            f_extra = extra;
            
            
			
			#if MASK_color && MASK_testu
                f_color = color + testu[0];
			#else
                f_color = vec4(.5,1,.5,1.0);
            #endif
            
             
            
		}
	"
	
	"
		in vec4 f_color;
		in vec2 f_texcoord;
		in vec4 f_extra;
		out vec4 pset;
		uniform sampler2D diff;
		
		void main(){
            
			pset = f_extra  +  f_color * texture( diff, f_texcoord);
		
		}
	
	"  GLSL 

end



//


type GLSLDecompiler
	dc:Decompiler;
	indentLevel:Z32;
end


proc Indent:(dc: GLSLDecompiler&)

    newline
    
    0#i
    loop i dc.indentLevel < while
        " " print
        i&++
    end
    
end


proc Dump:(t:ExecToken)


    t.prim  " \"" t.text "\"" prints

    
    t.consttype String& ==
	t.consttype String% == or if
		" " t.value:String& " " prints
	t.consttype Real ==
		" Real " t.value:Real " " prints
	else
		" " t.value:Z32 " " prints
	end
        
        
    
    t.evaltype:Bit if
        " produces " t.evaltype prints
    end
    
       

end

proc Instruction:(dc: GLSLDecompiler& ; t:ExecToken)
	dc Indent
	t Dump
	
	
end

proto End:(dc: GLSLDecompiler& ; t:ExecToken);

proc Begin:(dc: GLSLDecompiler& ; t:ExecToken)
    dc Indent
	"begin " t.text "{" prints 
	dc.indentLevel&++
	dc:Decompiler& t.sub decompile  
end

proc End:(dc: GLSLDecompiler& ; t:ExecToken)
	dc.indentLevel&--
	dc Indent
	"}end " prints 
	
	t Dump
end

GLSLDecompiler new #decomp

primitive symtoken :ExecToken:(s:Symbol -> ExecToken);


proc dsym:(s:Symbol)
    "symbol type: " print
    s.type print newline
    decomp:Decompiler&  s:ExecToken decompile 
end


proc minShader:(per a:[Vec3]&; per b:[Vec3]& ; c:Vec3 -> )

    a b + c +

end

[Vec3]& [Vec3]& Vec3  minShader&:Symbol dsym



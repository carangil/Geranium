//compile a shader with inline GLSL source
/*

proc    shader% testVertexShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real&;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		extra: Vec4&;
		per texcoord:	[Vec2]&;
		->GLSLBody
		)
		
		
        				
	"
		in vec4 point;
		#if MASK_color
		in vec4 color;
		#endif
		
		uniform vec4 extra;
		uniform mat4 projection;
		uniform mat4 modelView;
		uniform vec4 testu[8];
		uniform float offset;
		in vec2 texcoord;
		out vec2 f_texcoord;
		out vec4 f_color;
		out vec4 f_extra;
		
		void main(){
			vec4 transformed = modelView * vec4(point.x+offset, point.y, point.z +testu[3].y, 1.0);
			//vec4 transformed = modelView * point;
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
            
            f_extra = extra;
            
            
			
			#if MASK_color && MASK_testu
                f_color = color + testu[0];
			#else
                f_color = vec4(.5,1,.5,1.0);
            #endif
            
             
            
		}
	"
	
	"
		in vec4 f_color;
		in vec2 f_texcoord;
		in vec4 f_extra;
		out vec4 pset;
		uniform sampler2D diff;
		
		void main(){
            
			pset = f_extra  +  f_color * texture( diff, f_texcoord);
		
		}
	
	" 

end  glslRaw
*/

proc    shader% testShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real&;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		extra: Vec4&;
		per texcoord:	[Vec2]&;
		->GLSLBody
		)
		
	"
	    out vec2 f_texcoord;
		out vec4 f_color;
		out vec4 f_extra;
	    
		void main(){
			vec4 transformed = modelView * vec4(point.x+offset, point.y, point.z +testu[3].y, 1.0);
			//vec4 transformed = modelView * point;
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
            
            f_extra = extra;

			
			#if MASK_color && MASK_testu
                f_color = color + testu[0];
			#else
                f_color = vec4(.5,1,.5,1.0);
            #endif
            
		}
	"
	
	"
        in vec4 f_color;
		in vec2 f_texcoord;
		in vec4 f_extra;
		out vec4 pset;
		void main(){
			pset = f_extra  +  f_color * texture( diff, f_texcoord);
		}
	" 

end glslHeaders     //glslHeaders generate the vertex shader inputs and vertex/fragment shader uniforms
                    //only the vertex-shader-generated output and pixel-shader-used inputs need to be in the source
                    

//glsl functions
proto PSet:(color:Vec4);


Vec4 PSet&:Symbol  #glslPSet


proc fcompileTest:() 
    

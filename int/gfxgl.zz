proc immediate arrayof:(t:Type&->Type&)
    category_array t 0:String& 0 ZFindType return
end

proc immediate .&:(t:Type&->Type&)
    category_reference t 0:String& 0 ZFindType return
end

proc immediate .%:(t:Type&->Type&)
    category_possessive t 0:String& 0 ZFindType return
end


selector VBO.vb:VBuffer%;


immediate
    2 #category_reference
    8 #category_possessive
    5 #category_array
end

proc  arrayof:(t:Type&->Type&)
    category_array t 0:String& 0 ZFindType return
end

proc  .&:(t:Type&->Type&)
    category_reference t 0:String& 0 ZFindType return
end

proc  .%:(t:Type&->Type&)
    category_possessive t 0:String& 0 ZFindType return
end



stacked Vec2;
type Vec2
    s:Real;
    t:Real;
end

stacked Vec4;
type Vec4
    r:Real;
    g:Real;
    b:Real;
    a:Real;
end


type Matrix44
	A:Vec4;
	B:Vec4;
	C:Vec4;
	D:Vec4;
end


proc :Vec2:(s:Real;t:Real->Vec2)
	var v:Vec2;
	s v.s=
	t v.t=
	v return
end

proc :Vec4:(r:Real;g:Real;b:Real;a:Real->Vec4)
	var v:Vec4;
	r v.r=
	g v.g=
	b v.b=
	a v.a=
	v return
end


proc print:(point:Vec3->)
    "<" print point.x print  "," print point.y print  "," print point.z print ">" print
end

proc print:(point:Vec4->)
    "<" print point.r print  "," print point.g print  "," print point.b print "," print point.a print ">" print
end


proc UpdatePixels:(w:ZWindow& -> )    w 0:Void& UpdatePixels   end
proc Done:(vb:VBuffer&; attr:Z32;x:Real; y:Real; z:Real->)   vb attr x y z 0.0 Done  end
proc Data:(vb:VBuffer&; attr:Z32;x:Real; y:Real; z:Real->)   vb attr x y z 0.0 Data  end
proc Done:(vb:VBuffer&; attr:Z32;x:Real; y:Real->)           vb attr x y 0.0 0.0 Done  end
proc Data:(vb:VBuffer&; attr:Z32;x:Real; y:Real->)           vb attr x y 0.0 0.0 Data  end


stacked Vec3;  //Vec3 structs are put on the stack

proc :Vec3:(a:Real;b:Real;c:Real->Vec3)     
   var v:Vec3;
    a v.x=
    b v.y=
    c v.z=  
    v return
end

proc LoadTexture:(filename:String&->Texture%)
    filename ZTGA_TOP BitmapLoadTGA #img
    img keep CreateTexture  return
end



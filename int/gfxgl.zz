		per color:	[Vec4]&; 
		offset:		Real&;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		extra: Vec4&;
		per texcoord:	[Vec2]&;
		->GLSLBody
		)
		
		
        				
	"
		in vec4 point;
		#if MASK_color
		in vec4 color;
		#endif
		
		uniform vec4 extra;
		uniform mat4 projection;
		uniform mat4 modelView;
		uniform vec4 testu[8];
		uniform float offset;
		in vec2 texcoord;
		out vec2 f_texcoord;
		out vec4 f_color;
		out vec4 f_extra;
		
		void main(){
			vec4 transformed = modelView * vec4(point.x+offset, point.y, point.z +testu[3].y, 1.0);
			//vec4 transformed = modelView * point;
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
            
            f_extra = extra;
            
            
			
			#if MASK_color && MASK_testu
                f_color = color + testu[0];
			#else
                f_color = vec4(.5,1,.5,1.0);
            #endif
            
             
            
		}
	"
	
	"
		in vec4 f_color;
		in vec2 f_texcoord;
		in vec4 f_extra;
		out vec4 pset;
		uniform sampler2D diff;
		
		void main(){
            
			pset = f_extra  +  f_color * texture( diff, f_texcoord);
		
		}
	
	" 

end  glslRaw
*/

proc    shader% testShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real&;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		extra: Vec4&;
		per texcoord:	[Vec2]&;
		->GLSLBody
		)
		
	"
	    out vec2 f_texcoord;
		out vec4 f_color;
		out vec4 f_extra;
	    
		void main(){
			vec4 transformed = modelView * vec4(point.x+offset, point.y, point.z +testu[3].y, 1.0);
			//vec4 transformed = modelView * point;
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
            
            f_extra = extra;

			
			#if MASK_color && MASK_testu
                f_color = color + testu[0];
			#else
                f_color = vec4(.5,1,.5,1.0);
            #endif
            
		}
	"
	
	"
        in vec4 f_color;
		in vec2 f_texcoord;
		in vec4 f_extra;
		out vec4 pset;
		void main(){
			pset = f_extra  +  f_color * texture( diff, f_texcoord);
		}
	" 

end glslHeaders     //glslHeaders generate the vertex shader inputs and vertex/fragment shader uniforms
                    //only the vertex-shader-generated output and pixel-shader-used inputs need to be in the source
                    

//glsl functions
proto PSet:(color:Vec4);


Vec4 PSet&:Symbol  #glslPSet


proc fcompileTest:() 
    
    1.0 0.0 0.0 1.0 :Vec4 PSet
    
end

virtual Exp;
selector Exp.text:String%;
selector Exp.type:Type&;
selector Exp.args:[Exp%]%;
selector ex Write:(ex:Exp&; ->String% );


type GLSLTerminal
    text:String%;
    type:Type&;
    args:[Exp%]%;  //args that might have been used at compile time to generate this leaf node... not used at runtime
    exp:Exp;
end

proc Write:(exp:GLSLTerminal& ->String%)
    exp.text keep return
end

type GLSLBinop
    text:String%;
    args:[Exp%]%;
    type:Type&;
    noParen:Bit;
    
    exp:Exp;
    
end

proc Write:(exp:GLSLBinop& ->String%)
    
    exp.noParen if
        "" copy         #Popen
        ""            #Pclose
    else
        "(" copy        Popen=
        ")"             Pclose=
    end
    
    Popen take
    exp.args 0[] Write ++
    
    exp.text ++
    
    exp.args 1[] Write ++
    Pclose ++
    
    return
end
  
type GLSLFuncOp
    text:String%;
    args:[Exp%]%;
    type:Type&;
    exp:Exp;
end

proc Write:(exp:GLSLFuncOp& ->String%)

    exp.text copy "(" ++ #s
    
    0#i loop i exp.args  .count < while
    
        i 0 > if 
            s take ", " ++ s=
        end
            
        s take exp.args i[] Write ++ s=
        
        i&++
    end
    
    s take ")" ++ return
    
end


type GLSLDecompiler
    //for printing
	indentLevel:Z32;
		
	curargs:[Exp%]%;
		
	dc:Decompiler;
end

proc Indent:(n: N32)
 newline   
    0#i
    loop i n < while
        " " print
        i&++
    end

end

proc Indent:(dc: GLSLDecompiler&)
    dc.indentLevel Indent
end


proc Dump:(t:ExecToken)

    t.prim  " \"" t.text "\"" prints
    t.consttype String& ==
	t.consttype String% == or if
		" " t.value:String& " " prints
	t.consttype Real == elseif
		" Real " t.value:Real " " prints
	else
		" " t.value:Z32 " " prints
	end

    t.evaltype:Bit if
        " produces " t.evaltype prints
    end

end

primitive C_ptrequal ==:(s:Symbol; a:any->Bit);

proto End:(dc: GLSLDecompiler& ; t:ExecToken);


proc Begin:(dc: GLSLDecompiler& ; t:ExecToken; subcount:N32)
    dc Indent "'" t.text "'" "{" prints newline
    t:Bit not if
        "null token" print loop end
    end
    
	dc.indentLevel&++


    var exp:Exp%;
    var subexp:[Exp%]%;
    
    dc.curargs take #saveArgs
   
    
    
    subcount 0 > if                //allocate space for args
       
        [Exp%] subcount new0 subexp=     
        subexp take dc.curargs=
    end
    
    
    t.prim "local" ==
    t.prim "perarg" == or
    t.prim "constant" == or   if
        "(local/perarg/varname)" t.text print
        GLSLTerminal new:Exp% exp=
        t.text copy exp.text=

    
    t.prim "stackread" == elseif
     "  (stackread varname)" t.sub.text prints newline
        GLSLTerminal new:Exp% exp=
        t.sub.text copy exp.text=
        
    t.text:Bit if " text " print end
    
    t.text "@" == elseif //load function
        GLSLTerminal new:Exp% exp=
        "go into @" print newline
        dc:Decompiler& t.sub decompile
        "back to @" print newline
        
        dc.curargs:Bit if
            "got value " dc.curargs 0[].text prints newline
            dc.curargs 0[].text copy exp.text=
        else
            "no value" print newline
        end
        
        
               
    t.text "=" ==    elseif     //assignment... args in opposite order than other binop nodes
    
        GLSLBinop new ##bin keep :Exp% exp=
        true bin.noParen=   //no parenthesis
      
        t.text copy exp.text=
        
        "into dest" print newline
        
        dc:Decompiler& t.sub.next   decompile1
        
        "into source" print newline
        dc:Decompiler& t.sub        decompile1
        dc.curargs take  exp.args=
        
    
    
    //functions and primitives named like infix operators are treated as such.
    t.text "=" == 
    t.text ">" == or
    t.text ">=" == or
    t.text "<" == or
    t.text "<=" == or
    t.text "==" == or
    t.text "!=" == or
    t.text "+" == or
    t.text "-" == or
    t.text "*" == or
    t.text "/" == or elseif
    
            
        GLSLBinop new:Exp% exp=
        t.text copy exp.text=
        dc:Decompiler& t.sub        decompile1
        dc:Decompiler& t.sub.next   decompile1
        dc.curargs take  exp.args=
        
      
    else
        dc Indent "TODO: '" t.text "' " t.prim prints
        t 1 Z32 Indent& disassemble
    end
    
    
  //  dc Indent "restore args" print newline
    saveArgs take dc.curargs=  //put args back
    
    
    
    exp:Bit if
    
        dc.curargs:Bit not if
            [Exp%] 8 new0 dc.curargs=   //create
        end
    
        //dc Indent "putting arg " dc.curargs.count " / " dc.curargs.size  prints newline
    
        exp take dc.curargs& push
    
    end
  
       
    
	
end


proc End:(dc: GLSLDecompiler& ; t:ExecToken)
    dc.indentLevel&--
//    dc Indent "}" print 
	//t Dump
end


   

proc dsym:(s:Symbol)
    
     GLSLDecompiler new #decomp

    
    newline
    "symbol type: " print
    s.type print newline
    
    decomp:Decompiler&   s.tokens decompile //s.tokens decompile 

    newline newline
    
    0#i loop i decomp.curargs.count < while
    
    
        decomp.curargs i [] Write #g 
        g ";" prints newline
        i&++
    end
    
    return
    
end


stacked sMatrix44;

proto @:(a:Transform& -> sMatrix44);
proto @:(a:Matrix44& -> sMatrix44);
proto +:(a:sMatrix44; b:sMatrix44 ->sMatrix44);
proto *:(a:sMatrix44; b:sMatrix44 ->sMatrix44);
proto -:(a:sMatrix44; b:sMatrix44 ->sMatrix44);
proto *:(a:sMatrix44; b:Real ->sMatrix44);


proc minShader:(t&:Matrix44&; u&:Matrix44&; per a:[Vec3]&; per b:[Vec3]& ; c:Vec3 ; d&: Vec3&  ; e:Real  -> )

 var x:Vec3;
 
  c b + x - x=

 
 
 
/*
 a b + 
 a c +
 a d +
 
e 2.0 +
    
1.0 #k
   
  
   
    k 1.0 + k=

   5.2  1.0 2.0 +  /   #g
   
   //a  b + #ff
   
   //a b Cross g=
  */ 
    
end

"x" print newline



0:Matrix44& 0:Matrix44& [Vec3]& [Vec3]& Vec3 Vec3& Real minShader&:Symbol.tokens 1 Z32 Indent& disassemble



0:Matrix44& 0:Matrix44&  [Vec3]& [Vec3]& Vec3 Vec3& Real minShader&:Symbol dsym

return



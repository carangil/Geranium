proc LoadTexture:(filename:String&->Texture%)
    filename ZTGA_TOP BitmapLoadTGA #img
    img keep CreateTexture  return
end

//Keep track if a key is being held down
[Bit] ZKEY_LASTKEY new #Keys
proc IsPressed:(key:N32->Bit)
    Keys key[] return
end

proc IsPressed:(s:String& -> Bit)
    s 0[]:N32 IsPressed return
end



    


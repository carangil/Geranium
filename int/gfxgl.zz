	type SomeVertexFormat
		position:Vec3
		color:Vec3
	end
	SomeVertexFormat] 10 new #singleVBO
*/

[Vec3] 10 new #positions		//ANY (simple) array can be converte to a VBO without having to do anything special
[Vec4] 10 new #colors
[Vec4] 8 new #testu	//testu is a uniform array
[Vec2] 10 new #txc //texture coords

-0.4  -0.5  2.0 :Vec3 positions 0[]=

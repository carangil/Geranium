proc immediate GLSL:(code a:String&; code b:String&->Code%)
	code \\
		'a		//vertex shader source string
		'b		//fragment shader source string
		glsl	//at compile time, create a structure that contains the source, and datatype of the function this is in the body of.
				//that struct pointer is baked into a push h_constant for runtime
		prep 	//at run time, this creates VBOs if needed, compiles the shader if needed, and binds vbos, and updates uniforms, and sets that shader as current
		return	//that prepped shader is returned for one or more draw calls
	\\ return
end

//compile a shader with inline GLSL source

//code (per point:[Vec3]&; per color:[Vec3]& ->GLSLDrawProc)  \\
	
	1.0 2.0 :Vec3 #h2
	
proc  testVertexShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real;
		projection:	Matrix44&; 
		modelView:	Matrix44&;	
		diff: 		Texture&;
		per texcoord:	[Vec2]& 	->GLSLDrawProc)
		
	"
		in vec3 point;
		in vec4 color;
		uniform mat4 projection;
		uniform mat4 modelView;
		uniform vec4 testu[8];
		uniform float offset;
		in vec2 texcoord;
		out vec2 f_texcoord;	
		out vec4 f_color;
		
		void main(){
			vec4 transformed = modelView * vec4(point.x, point.y, point.z+offset, 1.0);
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
			f_color = color + testu[0];
		}
	"
	
	"
		in vec4 f_color;
		in vec2 f_texcoord;
		out vec4 pset;
		uniform sampler2D diff;
		
		void main(){
		
			pset = f_color * texture( diff, f_texcoord);
		
		}
	
	"  GLSL 

end

 //#testVertexShader



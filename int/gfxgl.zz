"glgraphics.zz" include


proc LoadTexture:(filename:String&->Texture%)
    filename ZTGA_TOP BitmapLoadTGA #img
    img keep CreateTexture  return
end

//Keep track if a key is being held down
[Bit] ZKEY_LASTKEY new #Keys
proc IsPressed:(key:N32->Bit)
    Keys key[] return
end

proc IsPressed:(s:String& -> Bit)
    s 0[]:N32 IsPressed return
end


//create an opengl window
"Test Window" 1024 768 0 NewGraphicsWindow #window

//set dark blue background color
0.0 0.0 0.1 1.1 BackgroundColor

//load assets
"../../Zcore-data/web/Rock_044_SD/Rock_044_Normal.tga"      LoadTexture #Rock_Normal
"../../Zcore-data/web/Rock_044_SD/Rock_044_Height.tga"      LoadTexture #Rock_Height
"../../Zcore-data/web/Rock_044_SD/Rock_044_BaseColor.tga"   LoadTexture #Rock_Diffuse

"../../Zcore-data/cube.obj" 1.0 MeshLoadObj #CubeMesh
//"@../gfxtest/vertex.glsl" "@../gfxtest/fragment.glsl" DefaultShader 
"@../gfxtest/finevertex.glsl" "@../gfxtest/finefragment.glsl" DefaultShader 

/*
NewStyle    #st 

            st GFX_TEXTURE "texture_diffuse" 0 0        Rock_Diffuse:Void&  0 Set
            st GFX_TEXTURE "texture_height" 0 0         Rock_Height:Void&  0 Set
            st GFX_TEXTURE "texture_normal_tangent" 0 0 Rock_Normal:Void&  0 Set

            50.0 #sh
            st GFX_FLOAT "specular_exponent"  0 0 sh&:Void&  0 Set
            -3.0 4.0 10.0 :Vec3 #lightPos
          
st Use
*/  

//Transform new ##camera gfx_camera_init
var camera:Transform;

camera gfx_camera_init  


-1.0 0.0 5.0 :Vec3 camera.Position=
      
0.01 #step
 
false #mouseRel



//compile a shader with inline GLSL source
proc  testVertexShader:	(
		per point:	[Vec3]&; 
		testu:		[Vec4]&;  
		per color:	[Vec4]&; 
		offset:		Real;
		projection:	Matrix44&; 
		modelView:	Transform&;	
		diff: 		Texture&;
		per texcoord:	[Vec2]& 	->GLSLDrawProc)
		
	"
		in vec3 point;
		in vec4 color;
		uniform mat4 projection;
		uniform mat4 modelView;
		uniform vec4 testu[8];
		uniform float offset;
		in vec2 texcoord;
		out vec2 f_texcoord;	
		out vec4 f_color;
		
		void main(){
			vec4 transformed = modelView * vec4(point.x, point.y, point.z+offset, 1.0);
			gl_Position=  projection * transformed;
			f_texcoord = texcoord;
			f_color = color + testu[0];
		}
	"
	
	"
		in vec4 f_color;
		in vec2 f_texcoord;
		out vec4 pset;
		uniform sampler2D diff;
		
		void main(){
		
			pset = f_color * texture( diff, f_texcoord);
		
		}
	
	"  GLSL 

end

 //#testVertexShader


//some graphics data



/*
	TODO: arrays of structs should be able to be packaged into a VBO w/ interleaving.  Not supported yet; seperate VBO per item
	type SomeVertexFormat
		position:Vec3
		color:Vec3
	end
	SomeVertexFormat] 10 new #singleVBO
*/

[Vec3] 10 new #positions		//ANY (simple) array can be converte to a VBO without having to do anything special
[Vec4] 10 new #colors
[Vec4] 8 new #testu	//testu is a uniform array
[Vec2] 10 new #txc //texture coords

-0.4  -0.5  2.0 :Vec3 positions 0[]=
 0.6  -0.65  2.0 :Vec3 positions 1[]=
-0.66   0.67  2.0 :Vec3 positions 2[]=



1.0 0.0 0.0 1.0 :Vec4 colors 0[]=
0.0 1.0 0.0 1.0 :Vec4 colors 1[]=
0.0 0.0 1.0 1.0 :Vec4 colors 2[]=

0.0 0.0 :Vec2 txc 0[]=
1.0 0.0 :Vec2 txc 1[]=
0.0 1.0 :Vec2 txc 2[]=

0.5 0.5 0.5  1.0:Vec4 testu 0[]=
0.8 -1.0 0.8  1.0 :Vec4 testu 1[]=




0.0 #offset

//testComputeShader

	

loop
   
    
     0.0 #droll 0.0 #dpitch 0.0 #dyaw

     // WindowEventLoop
     var ev:ZEvent;
     
     loop window ev GetEvent  while
        //"Event " print ev.eventType print  "    " print     newline
        //key up/down events
                
        //grab key up/down state
        ev ZEVENT_KEY_DOWN is?  if 
            true Keys ev.A[] =
        ev ZEVENT_KEY_UP is? elseif

            false Keys ev.A[] =
            
            ev.A ZKEY_ESCAPE == if
                window keep Close
            end
            
        end
        
     
        //deal with mouse deltas
        ev ZEVENT_MOUSE_DELTA is?    if
            ev.A:Real -200.0 / dyaw=
            ev.B:Real  200.0 / dpitch=           
        end
        
        
        // char events
        ev ZEVENT_CHAR is? if
        
            ev.A "+"0[]:N32 == if
            
                step 1.05 * step=
                
            
            ev.A "-"0[]:N32 ==  elseif
            
                step 0.95 * step=
                
            ev.A "m"0[]:N32 ==  elseif
                
                mouseRel not mouseRel=

                window mouseRel MouseDelta

            end
        end
       
    end
    
    ev.eventType ZEVENT_CLOSE == if
        window take Close
        break //break main loop
    end
                
                
    80.0     4.0 3.0/   0.01 1000.0 Setup3D
    1:Bit 1:Bit FrameClear
        
	
    var tr:Transform;
	
	tr gfx_save_transform
	
	positions testu colors offset GetProjectionMatrix tr Rock_Height  txc testVertexShader GFX_TRIANGLE 0 4 draw
		
	offset 0.001 + offset=
		
    
    0.0 #dx 0.0 #dy 0.0 #dz
    
    "a" IsPressed if   step.-   dx=     end
    "d" IsPressed if   step     dx=     end
    "w" IsPressed if   step     dz=     end
    "s" IsPressed if   step.-   dz=     end
    "r" IsPressed if   step     dy=     end
    "f" IsPressed if   step.-   dy=     end
    "q" IsPressed if   step.-   droll=  end
    "e" IsPressed if   step     droll=  end

    camera dz dx dy dyaw dpitch droll gfx_camera_motion_6dof
    camera gfx_camera_view

  //  st GFX_FLOAT3 "light_position" 0 0 lightPos&:Void& GFX_TRANSFORM_POINT Set

   // CubeMesh.vb GFX_TRIANGLE 0 24:N32 1:Bit Draw
   // st Use
   // CubeMesh.vb GFX_TRIANGLE CubeMesh.start CubeMesh.stop  1:Bit Draw

    window SwapBuffers  
  
end




var a:Transform;


proc print:(point:Vec3&->)
    "<" print point.x print  "," print point.y print  "," print point.z print ">" print
end

proc print:(aa:Transform&->)

    "pos:" print aa.Position print
    ",x:" print aa.Rotation.XAxis print
    ",y:" print aa.Rotation.YAxis print 
    ",z:" print aa.Rotation.ZAxis print

end

a gfx_trans_init
a print




//todo: need to import all the vector math operations
proc =:(x:Real; y:Real;z:Real;v:Vec3&->)
    x v.x=
    y v.y=
    z v.z=
end


stacked Vec3;  //Vec3 structs are put on the stack

proc print:(point:Vec3->)
    "byval " print
    
       
   
    
    point #p        //access by value
    
    p& print
    
   
    "<b " print point.x print  "," print point.y print  "," print point.z print ">" print
   "byval end" print
end

proc mkvec3:(a:Real;b:Real;c:Real->Vec3)

    var v:Vec3;
    a v&.x=
    b v&.y=
    c v&.z=
    
    v return
end



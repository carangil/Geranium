0.0 #offset

//testComputeShader

	
loop
   
    
     0.0 #droll 0.0 #dpitch 0.0 #dyaw

     // WindowEventLoop
     var ev:ZEvent;
     
     loop window ev GetEvent  while
        //"Event " print ev.eventType print  "    " print     newline
        //key up/down events
                
        //grab key up/down state
        ev ZEVENT_KEY_DOWN is?  if 
            true Keys ev.A[] =
        ev ZEVENT_KEY_UP is? elseif

            false Keys ev.A[] =
            
            ev.A ZKEY_ESCAPE == if
                window keep Close
            end
            
        end
        
     
        //deal with mouse deltas
        ev ZEVENT_MOUSE_DELTA is?    if
            ev.A:Real -200.0 / dyaw=
            ev.B:Real  200.0 / dpitch=           
        end
        
        
        // char events
        ev ZEVENT_CHAR is? if
        
            ev.A "+"0[]:N32 == if
            
                step 1.05 * step=
                
            
            ev.A "-"0[]:N32 ==  elseif
            
                step 0.95 * step=
                
            ev.A "m"0[]:N32 ==  elseif
                
                mouseRel not mouseRel=

                window mouseRel MouseDelta

            end
        end
       
    end
    
    ev.eventType ZEVENT_CLOSE == if
        window take Close
        break //break main loop
    end
                
                
    80.0     4.0 3.0/   0.01 1000.0 Setup3D
    1:Bit 1:Bit FrameClear
        
	
    var tr:Transform;
	
	tr gfx_save_transform
	
	var extra:Vec4;
	1.0 0.0 0.0 1.0 :Vec4 extra=
	

	
	//"string" 3[]& #aa typeof print newline
	
	//"string" copy& ##a typeof print newline
	
	
	//positions testu colors offset& GetProjectionMatrix tr Rock_Height   extra& txc testVertexShader& ##tvs typeof print newline

  
	
		
    positions testu colors offset& GetProjectionMatrix tr Rock_Height   extra& txc  testShader Prepare  GFX_TRIANGLE 0 3 Draw

    
	
	//positions testu colors offset& GetProjectionMatrix tr Rock_Height   extra& txc testVertexShader GFX_TRIANGLE 0 4 draw
	

	//positions testu 0:[Vec4]& offset GetProjectionMatrix tr Rock_Height  txc testVertexShader GFX_TRIANGLE 0 4 draw
	
		
	//positions 0:[Vec4]& colors 0:any&:Real& GetProjectionMatrix tr Rock_Height   extra&  txc testVertexShader GFX_TRIANGLE 0 4 draw
	
		
	offset 0.01 + offset=
    testu 3[].g   0.01 +   testu 3[].g=
    
    0.0 #dx 0.0 #dy 0.0 #dz
    
    "a" IsPressed if   step.-   dx=     end
    "d" IsPressed if   step     dx=     end
    "w" IsPressed if   step     dz=     end
    "s" IsPressed if   step.-   dz=     end
    "r" IsPressed if   step     dy=     end
    "f" IsPressed if   step.-   dy=     end
    "q" IsPressed if   step.-   droll=  end
    "e" IsPressed if   step     droll=  end

    camera dz dx dy dyaw dpitch droll gfx_camera_motion_6dof
    camera gfx_camera_view

  //  st GFX_FLOAT3 "light_position" 0 0 lightPos&:Void& GFX_TRANSFORM_POINT Set

   // CubeMesh.vb GFX_TRIANGLE 0 24:N32 1:Bit Draw
   // st Use
   // CubeMesh.vb GFX_TRIANGLE CubeMesh.start CubeMesh.stop  1:Bit Draw

    window SwapBuffers  
  
end




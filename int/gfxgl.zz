"base/base.zz" include
"gen.zz" include


proc UpdatePixels:(w:ZWindow& -> )    w 0:Void& UpdatePixels   end
proc Done:(vb:VBuffer&; attr:Z32;x:Real; y:Real; z:Real->)   vb attr x y z 0.0 Done  end
proc Data:(vb:VBuffer&; attr:Z32;x:Real; y:Real; z:Real->)   vb attr x y z 0.0 Data  end
proc Done:(vb:VBuffer&; attr:Z32;x:Real; y:Real->)           vb attr x y 0.0 0.0 Done  end
proc Data:(vb:VBuffer&; attr:Z32;x:Real; y:Real->)           vb attr x y 0.0 0.0 Data  end

stacked Vec3;  //Vec3 structs are put on the stack

proc :Vec3:(a:Real;b:Real;c:Real->Vec3)     
   var v:Vec3;
    a v.x=
    b v.y=
    c v.z=  
    v return
end

proc LoadTexture:(filename:String&->Texture%)
    filename ZTGA_TOP BitmapLoadTGA #img
    img keep CreateTexture  return
end


//Keep track if a key is being held down
[Z32] ZKEY_LASTKEY new #Keys
proc IsPressed:(key:Z32->Bit)
    Keys key[] 1 == return
end

//create an opengl window
"make window" print newline

"Test Window" 1024 768 0 GLWindow #window

0.0 0.0 0.1 1.1 BackgroundColor

//load assets
"../../Zcore-data/web/Rock_044_SD/Rock_044_BaseColor.tga"   LoadTexture #Rock_Diffuse
"../../Zcore-data/web/Rock_044_SD/Rock_044_Normal.tga"      LoadTexture #Rock_Normal
"../../Zcore-data/web/Rock_044_SD/Rock_044_Height.tga"      LoadTexture #Rock_Height

"../../Zcore-data/cube.obj" 1.0 MeshLoadObj #CubeMesh

//"@../gfxtest/vertex.glsl" "@../gfxtest/fragment.glsl" DefaultShader 
"@../gfxtest/finevertex.glsl" "@../gfxtest/finefragment.glsl" DefaultShader 

NewStyle    #st 

            st GFX_TEXTURE "texture_diffuse" 0 0        Rock_Diffuse:Void&  0 Set
            st GFX_TEXTURE "texture_height" 0 0         Rock_Height:Void&  0 Set
            st GFX_TEXTURE "texture_normal_tangent" 0 0 Rock_Normal:Void&  0 Set

            -1.0 2.0 3.0 :Vec3 #lightPos

            st GFX_FLOAT3 "light_position" 0 0 lightPos&:Void& GFX_TRANSFORM_POINT Set

st Use

//window  "color:4|position:3|texcoord:2" TempVBuffer #vb
      

//"../../Zcore-data/font32.tga" ZTGA_TOP BitmapLoadTGA #bbb
//bbb keep CreateTexture  #fonttexture

//var camera:Transform;
Transform new ##camera gfx_camera_init

-1.0 0.0 5.0 :Vec3   camera.Position=
            
0.001 #step
  
loop
     // WindowEventLoop
     var ev:ZEvent;
     loop
        
        window ev GetEvent  while
        "Event " print ev.eventType print  "    " print     newline
      
        //key up/down events
        ev.eventType   ZEVENT_KEY ZEVENT_DOWN or == if 
            1 Keys ev.A[] =
        ev.eventType   ZEVENT_KEY ZEVENT_UP or == elseif
            0 Keys ev.A[] =
        end

        // char events
        ev.eventType ZEVENT_CHAR == if
            ev.A "+"0[]:N32 == if
                step 1.05 * step=
            ev.A "-"0[]:N32==  elseif
                step 0.95 * step=
            end
        end

    end
    
    ev.eventType ZEVENT_CLOSE == if 
        "Closing window" print newline
        window take Close
        break
    end
                
    80.0     4.0 3.0/   0.01 1000.0 Setup3D
    1:Bit 1:Bit FrameClear
        
    proc IsPressed:(s:String& -> Bit)
        Keys s 0[] :Z32 []1 == return
    end

    0.0 #dx 0.0 #dy 0.0 #dz
    
    "a" IsPressed if   step.- dx=     end
    "d" IsPressed if   step   dx=     end
    "w" IsPressed if   step   dz=     end
    "s" IsPressed if   step.- dz=     end
    "r" IsPressed if   step   dy=     end
    "f" IsPressed if   step.- dy=     end

    camera dz dx dy 0.0 0.0 0.0 gfx_camera_motion_6dof
    camera gfx_camera_view

   // CubeMesh.vb GFX_TRIANGLE 0 24:N32 1:Bit Draw
    
    CubeMesh.vb GFX_TRIANGLE CubeMesh.start CubeMesh.stop  1:Bit Draw

    window UpdatePixels  
  
end



var a:Transform;


proc print:(point:Vec3->)
    "<" print point.x print  "," print point.y print  "," print point.z print ">" print
end

proc print:(aa:Transform&->)
    "Transform " print
    "pos:" print aa.Position print
    ",x:" print aa.Rotation.XAxis print
    ",y:" print aa.Rotation.YAxis print 
    ",z:" print aa.Rotation.ZAxis print

end

a gfx_trans_init
a print

proc =:(x:Real; y:Real;z:Real;v:Vec3&->)
    x v.x=
    y v.y=
    z v.z=
end



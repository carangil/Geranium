proc print:(point:Vec3->)
    "byval " print
    
       
   
    
    point #p        //access by value
    
    p& print
    
   
    "<b " print point.x print  "," print point.y print  "," print point.z print ">" print
   "byval end" print
end

proc mkvec3:(a:Real;b:Real;c:Real->Vec3)

    var v:Vec3;
    a v.x=
    b v.y=
    c v.z=
    
    v return
end



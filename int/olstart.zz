proc immediate MapOf:(vt:Type&)


    vt.name "_MapOf" ++    #name
    
    name:Type:Bit if
        return
    end
    
    code () \
        type 'name
            h:HashMap;
        end
    \ ##c
    
    
    code \
        proc []:(sh:'name &; key: String& -> $vt% )
            sh.h key []:String% return
        end
        proc []=:(v:$vt%; sh:'name&; key:String&)
            v take sh.h key []= 
        end
        
    \ insert
    
end





//float


primitive printfloat	print:(f:Real->);

primitive fadd	+:(a:Real; b:Real	-> Real);
primitive fsub	-:(a:Real; b:Real	-> Real);
primitive fmul	*:(a:Real; b:Real	-> Real);
primitive fdiv	/:(a:Real; b:Real	-> Real);
primitive fpow	^:(a:Real; b:Real	-> Real);

primitive fabs	abs:(a:Real	-> Real);
primitive fsqrt	sqrt:(a:Real	-> Real);

primitive fneg	negative:(a:Real	-> Real);

primitive fsin	sin:(a:Real	-> Real);
primitive fcos	cos:(a:Real	-> Real);
primitive ftan	tan:(a:Real	-> Real);

primitive fasin	arcsin:(a:Real	-> Real);
primitive facos	arccos:(a:Real	-> Real);
primitive fatan	arctan:(a:Real	-> Real);

primitive fatan2 arctan2:(x:Real; y:Real	-> Real);

primitive flesse	<=:(a:Real; b:Real	-> Bit);


primitive fload		@:(a:Real& 	-> Real);
primitive fstore	=:(v:Real; a:Real&-> );

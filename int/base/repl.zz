

proc sys_Repl:()

    newline    
    "Z interactive" print newline
 
    loop
        
        "" copy #source
        "Z> " print
        1 #linecount
        
        loop
            
            readline #line 
            
            line "." == if 
            
                code (->) \ 'source \ #f 
            
                //got a function?
                f& if 
                    cover
                        f
                    end
                    newline
                end
                                
                error?  if
                    "" copy error? .appendhex  errorMessage  prints newline
                    clearError
                end
                            
                break
                
                
            line "quit" == 
            line "exit" == or elseif
                true #doQuit
                break
            end
            

           source take line ++  LF ++  source=
           
            linecount&++
            linecount " : " prints
           
       
            
        end//loop
        
        doQuit until
        
    end//loop

end

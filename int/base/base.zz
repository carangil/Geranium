//more includes at bottom on this file



//define some language extensions by using immediate procs

// 'until' will break a for loop if the value is true

proc immediate until:(code b:Bit->Code%)
    code \
        'b if break end
    \ return
end


//while will break a for loop if the value is false.  Can appear anywhere in the loop, or multiple until/whiles
proc immediate while:(code b:Bit->Code%)
    code \
        'b not if break end
    \ return
end


proc newline:(->)
	10 :N8 print
	return
end

proc space:(->)
	32 :N8 print
	return
end


proc print:(s:String&->)

	s:Bit not if
		"{null}" print
		return
	end
	
	s.size 0== if
        "{0count}" print
        return
	end
	
	0 #i
	loop
		s i[] :Z32 0 == if
			return
		end
		s i[] print
		i 1+ i=
	end

end

proc immediate prints:(a:Empty)
end


proc immediate prints:(code a:any->Code%)
	code \
		prints 'a print 
	\ return	
end

proc immediate printsln:(code a:any->Code%)
	code \
		prints 'a print newline
	\ return	
end


proc ++:(a:Z32&->)
	a@ 1+ a@=
	return
end

proc --:(a:Z32&->)
	a@ 1- a@=
	return
end

proc readline:(->String%)

	10 #size		
	0 #i
	
	[N8] size new #s	//allocate initial small array (alreayd zerod out, no need to null terminate)
	
	loop
		getch #c			//read a character
		c:Z32 10 == if break end	//if newline, exit loop
		
		c s i[]=		//set s[i] to c
		
		i& ++
	
		i size 1- == if		//if reached the size -1
			//need to grow
			size 2* #newsize		//newsize is double
			[N8] newsize new #ns		//allocate new array
			
			0 #j loop
				s j[] ns j[]=		//copy byte 
				j&++			//increment j
				j size == until	//break when done copying
			end
			
			ns take s =	//s takes ownership of ns
			newsize size=
		end
	end
	
	s take return  //take ownership of s, cast to a string pointer, return ownership of s
	
end

proc .len:(s:String& -> Z32)

	0 #i
	loop
		s i[] 0:N8 == if
			i return
		end
		i&++
	end
	
	0 return
	
end

proc copy:(s:String& -> String%)
	s.len #le
	
	[N8] le 1+  new #news
	
	0 #i loop
		s i[] news i[]=
		s i[] 0:N8 == if
			news take  return
		end
		i&++
	end
	
    null return
end

proc ==:(si:String&; ti:String& -> Bit)

	si #s
	ti #t
	
	s:Bit not if
		"" s=
	end
	
	t:Bit not if
		"" t=
	end
	
	0#i
	loop
		 s i[] t i[] == not if
			false return
		 end

		s i[] 0:N8 == until
	
		i&++
	end

	true return
end

proc .hash:(s:String&->N32)
  

    0:N32 #hash
    
    0#i  loop 

        s i[] #c 
        c:Bit while
        
        hash    31 * 
                c:N32 + 
                        hash=
        i&++
    end 
    hash return
end



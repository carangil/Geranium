//string appending         string1 string2 ++

proc ++:(a:String&;b:String& ->String%)
    a copy #r
    r take b 0 -1 zstrcatsub return
end

//append owned string
proc ++:(a:String%;b:String& ->String%)
    a take b 0 -1 zstrcatsub return
end


//append owned string to other string
proc ++:(a:String%; b:String% ->String%)
    a take b 0 -1 zstrcatsub return
end



proc error:(msg:String&)
    msg copy 1 error
end

proc print:(s:String%)      //free the pointer when it prints
    s print
end

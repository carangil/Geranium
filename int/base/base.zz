//more includes at bottom on this file



//define some language extensions by using immediate procs

// 'until' will break a for loop if the value is true

proc immediate until:(code b:Bit->Code%)
    code \
        'b if break end
    \ return
end


//while will break a for loop if the value is false.  Can appear anywhere in the loop, or multiple until/whiles
proc immediate while:(code b:Bit->Code%)
    code \
        'b not if break end
    \ return
end

proto print:(s:String&->);
proto newline:(->);

proc immediate not:(code b:any->Code%)
	"auto insert :Bit" print newline
	code \\ 'b :Bit not \\ return
end

primitive loadptr H:( a:any&& -> like a@ );


//basic console io

primitive printchar print:(a:N8 ->);
primitive print32   print:(a:Z32 ->);
primitive print32   print:(a:N32 ->);
primitive print32   print:(a:Bit ->);
primitive printptr  printptr:(a:any& ->);
primitive printptr  printptr:(a:vany& ->);
primitive readchar  getch:(->N8);
primitive equal32   ==:(a:N8; b:N8 -> Bit);



proc newline:(->)
	10 :N8 print
	return
end

proc space:(->)
	32 :N8 print
	return
end


proc print:(s:String&->)

	s:Bit not if
		"{null}" print
		return
	end
	
	0 #i
	loop
		s i[] :Z32 0 == if
			return
		end
		s i[] print
		i 1+ i=
	end

end

proc immediate prints:(a:Empty)
end

proc immediate prints:(code a:any->Code%)
	code \
		prints 'a print 
	\ return	
end

proc ++:(a:Z32&->)
	a@ 1+ a@=
	return
end

proc --:(a:Z32&->)
	a@ 1- a@=
	return
end

proc readline:(->String%)

	10 #size		
	0 #i
	
	[N8] size new #s	//allocate initial small array (alreayd zerod out, no need to null terminate)
	
	loop
		getch #c			//read a character
		c:Z32 10 == until	//if newline, exit loop
		
		c s i[]=		//set s[i] to c
		
		i& ++
	
		i size 1- == if		//if reached the size -1
			//need to grow
			size 2* #newsize		//newsize is double
			[N8] newsize new #ns		//allocate new array
			
			0 #j loop
				s j[] ns j[]=		//copy byte 
				j&++			//increment j
				j size == until	//break when done copying
			end
			
			ns take s =	//s takes ownership of ns
			newsize size=
		end
	end
	
	s take:String% return  //take ownership of s, cast to a string pointer, return ownership of s
	
end

proc strlen:(s:String& -> Z32)

	0 #i
	loop
		s i[] 0:N8 == if
			i return
		end
		i&++
	end
	
	0 return
	
end

proc strdup:(s:String& -> String%)
	s strlen #le
	
	[N8] le 1+  new #news
	
	0 #i loop
		s i[] news i[]=
		s i[] 0:N8 == if
			
			news take :String%  return
		end
		i&++
	end
    0:String% return
end

proc ==:(si:String&; ti:String& -> Bit)

	si #s
	ti #t
	
	s:Bit not if
		"" s=
	end
	
	t :Bit not if
		"" t=
	end
	
	0#i
	loop
		 s i[] t i[] == not if
			false return
		 end

		s i[] 0:N8 == until
	
		i&++
	end

	true return
end


primitive arrayinfo 0 .size:( array:[any]& -> Z32);	
primitive arrayinfo 1 .count :( array:[any]& -> Z32);
primitive arrayinfo 2 .count=:( n:Z32; array:[any]&);	
primitive arrayinfo 3 resize:( n:Z32; Xarray:[any]% -> like Xarray  );	




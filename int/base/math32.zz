
primitive boolnot	not:(v:Bit -> Bit );



//signed integers
primitive add32			+:(a:Z32; b:Z32	-> Z32);
primitive sub32			-:(a:Z32; b:Z32	-> Z32);
primitive mul32			*:(a:Z32; b:Z32	-> Z32);
primitive divz32		/:(a:Z32; b:Z32	-> Z32);
primitive and32			and:(a:Z32; b:Z32	-> Z32);
primitive or32			or :(a:Z32; b:Z32	-> Z32);
primitive xor32			xor:(a:Z32; b:Z32	-> Z32);
primitive xor32			xor:(a:Z32; b:Z32	-> Z32);
primitive less32		<:(a:Z32; b:Z32	-> Bit);
primitive lesse32		<=:(a:Z32; b:Z32	-> Bit);
primitive greater32		>:(a:Z32; b:Z32	-> Bit);
primitive greatere32	>=:(a:Z32; b:Z32	-> Bit);
primitive load32		@:(a:Z32& 	-> Z32);
primitive store32		=:(v:Z32; a:Z32&-> );
primitive equal32		==:(a:Z32; b:Z32 -> Bit);
primitive store32np		#=:(v:Z32; a:Z32&->Z32);
primitive notequal32	!=:(a:Z32; b:Z32 -> Bit);
primitive neg32			.-:(v:Z32 -> Z32 );


//unsigned integers
primitive add32		 +:(a:N32; b:N32	-> N32);
primitive sub32		 -:(a:N32; b:N32	-> N32);
primitive mul32		 *:(a:N32; b:N32	-> N32);
primitive divu32	 /:(a:N32; b:N32	-> N32);
primitive modu32	mod:(a:N32; b:N32	-> N32);

//unsigned bitwise
primitive and32		and:(a:N32; b:N32	-> N32);
primitive or32		or :(a:N32; b:N32	-> N32);
primitive xor32		xor:(a:N32; b:N32	-> N32);
primitive invert32	not:(v:N32 -> N32 );

//unsigned comparison
primitive equal32		==:(a:N32; b:N32 -> Bit);
primitive notequal32	!=:(a:N32; b:N32 -> Bit);
primitive lessu32		 <:(a:N32; b:N32 -> Bit);
primitive lesseu32		<=:(a:N32; b:N32 -> Bit);
primitive greateru32	 >:(a:N32; b:N32 -> Bit);
primitive greatereu32	>=:(a:N32; b:N32 -> Bit);


//unsigned storage
primitive load32	@:(a:N32& 	-> N32);
primitive store32	=:(v:N32; a:N32&-> );
primitive store32np	#=:(v:N32; a:N32&->N32);

//8-bit storage format only
primitive load8		@:(a:N8& -> N8);
primitive store8	=:(v:N8; a:N8&-> );

proc mkType:(name:String&; elementType: String&-> myType%)

    code (->myType%) \
        "whatever" print newline
    
        type 'name
            a:Z32;
            val: 'elementType%;
        end
    
    
        myType new #oo
        12345 oo.a=
        "string stored in type" strdup oo.val=
        oo.val  print newline
        oo take return
        
    \ ##c exec return


end





//using virtual type as a function pointer

virtual Op;
selector op Do:(a:Z32; op:Op& ; b:Z32 ->Z32);   //the type of 'op' ... the selector arg, 


type Plus
    o:Op;
end
proc Do:(a:Z32; op:Plus&; b:Z32 -> Z32)
    a b + return
end


type Times
    o:Op;
end
proc Do:(a:Z32; op:Times&; b:Z32 -> Z32)
    a b * return
end

//These aren't actually necesssary, since Plus and Times types don't actually contain any information.  The selcetor

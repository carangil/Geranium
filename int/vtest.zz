5 f 10 Do g 20 Do print newline


//make it make more sense:

virtual FuncPointer; selector p Call:(a:Z32; p: FuncPointer&     -> Z32); 

type Add10 add10:FuncPointer; end proc Call:(a:Z32; p:Add10& -> Z32)
    a 10 + return
end

type Square square:FuncPointer; end proc Call:(a:Z32; p:Square& -> Z32)
    a a * return
end

var fp:FuncPointer&;
var gp:FuncPointer&;


//composite interfaces

virtual Reader;
virtual Writer;
virtual ReaderWriter;

selector x Read:(x:Reader& ->);
selector x Write:(x:Writer& ->);


selector x Read:(x:ReaderWriter& ->);
selector x Write:(x:ReaderWriter& ->);


selector ReaderWriter.r:Reader;



type Test
    r:Reader;
    w:Writer;
    rw:ReaderWriter;
end

proc Read:(a:Test&->)
     " Read called on Test" print newline
     return
end

proc Write:(a:Test&->)
     " Write called on Test" print newline
     return
end



var t:Test;

t:Reader& Read
t:Writer& Write


proc ww:(w:Writer&->)
     "Calling Write on a Writer&" print
    w Write
    return
end


proc frw:( rw:ReaderWriter& ->)
    "Calling Read on ReaderWriter& " print
    rw Read
    "Calling Write on ReaderWriter& " print
    rw Write
    
    
    "Caling ww on ReaderWriter&.. ww expects a Writer not a ReaderWriter "print
    
    
    
//    rw:Writer& ww
    
    return
end


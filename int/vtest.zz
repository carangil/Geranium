//composite interfaces


//create a couple types and their function selectors
virtual Reader;
virtual Writer;



selector x Rtest:(x:Reader& ->);
selector x Read:(x:Reader& ->);
selector x Write:(x:Writer& ->);
selector x Wtest:(x:Writer& ->);


virtual ReaderWriter;
selector x Write:(x:ReaderWriter& ->);
selector x Read:(x:ReaderWriter& ->);




type Test
    r:Reader;
    w:Writer;
    rw:ReaderWriter;
end

type T2
    
     r:Reader;
    w:Writer;
    rw:ReaderWriter;
end

proc Read:(a:Test&->)
     " Read called on Test" print newline
     return
end
proc Rtest:(a:Test&->)
     " Rtest called on Test" print newline
     return
end

proc Write:(a:Test&->)
     " Write called on Test" print newline
     return
end

proc Wtest:(a:Test&->)
     " Wtest called on Test" print newline
     return
end

proc Read:(a:T2&->)
     " Read called on T2" print newline
     return
end
proc Rtest:(a:T2&->)
     " Rtest called on T2" print newline
     return
end

proc Write:(a:T2&->)
     " Write called on T2" print newline
     return
end

proc Wtest:(a:T2&->)
     " Wtest called on T2" print newline
     return
end


//Adding a data selector to ReaderWriter.  But instead of a real type, the fields 'r' and 'w' are virtual types 'Reader' and 'Writer'  What this does is create a data selector r (or w) which points to the object's Reader or Writer selector table.  This means an instance of a Type that implements Reader and Writer must also include a Reader named r and a Writer named w.

selector ReaderWriter.r:Reader;
selector ReaderWriter.w:Writer; //adding a Writer selector to ReaderWriter


var t:Test;

proc G:(t:Test&->)
    "G called on Test " print 
    t :any& print newline
end

proc H:(t:T2&->)
    "H called on T2 " print 
    t :any& print newline
end



t:Reader& Read
t:Writer& Write


proc ww:(w:Writer&->)
     "Calling Write on a Writer&" print
    w Write
    return
end

proc rr:(r:Reader&->)
     "Calling Read on a Reader&" print
    r Read
    return
end
    
proc frw:(rw:ReaderWriter&->)

    

    "Calling Read and Write on rw" print newline
    rw Read
    rw Write


    
    
    //use the writer or reader part directly
    
    rw:Writer& ww
    rw:Reader& rr
    
    
    
    "---" print newline
    
    rw:Test& ##s if
        "rw is Test" print 
        s Write
        newline
    end
    
    rw:Test&  G //convert to real type Need to check its the correct type
    rw:T2&    H //convert to real type Need to check its the correct type
  
   "===" print newline
    
    
 //   rw?Test :any& print newline
  //  rw?T2   :any& print newline
    
    return
end

    
t:ReaderWriter&  frw

var t2:T2;

t2:ReaderWriter&  frw



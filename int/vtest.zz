//Data selectors


virtual D;

selector d F:( d:D& -> );  //proc selector
selector D.xx:Z32;    ///every D object has the field xx


type P
    
    a:Z32;
    xx:Z32;
    d:D; 
    e:E;    //also supports E
end



type Q
    
    xx:Z32;
    d:D;
end


proc F:(p:P&->)
    55 p.xx=
    "F called on P xx=" print  p.xx print newline
    
    return
end




var p:P;


proc FF:(pi:P&->)

 
        
    
    "call FF " print newline
    return
end



Q new #q    //create the variable


var Dq: D%;

proc F:(qi:Q&->) //method added after variable created! (as long as it exists before the first call or cast to virtual type, its ok
    66 qi.xx=
    "F called on Q xx=" print  qi.xx print newline
    
    //free the global Q (which would make the qi reference invalid BUT it was addreffed before calling this function
    "Dq is valid   " print Dq :any& print newline
    Dq take trash
    "Dq is now null  in F" print Dq :any& print newline
    " qi = " print qi:any& print newline  //this function (actualler the caller's addref on the pointer on the stack) has the last remaining reference.  Object released when this function returns
    
    return
end





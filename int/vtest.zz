//double dispatch

virtual V;
selector v F:( v:V&; v2:V& ->);

type A
    v:V;
end
type B
    v:V;
end



//second level dispatch

//A first case

selector v G:(a:A&;v:V& -> );
proc G:(a:A&; a2:A& -> )
    "first a; second a" print newline
    return
end
 

proc G:(a:A&; b:B& -> )
    "first a; second b" print newline
    return
end


//B first case
selector v G:(b:B&;v:V& -> );
proc G:(a:B&; b2:B& -> )
    "first b; second b" print newline
    return
end
 

proc G:(a:B&; a:A& -> )
    "first b; second a" print newline
    return
end
    


//first level dispatch

proc F:(a:A&; v:V& ->)
    "first A " print
    a v G
    return
end



proc F:(b:B&; v:V& ->)
    "first B " print 
    b v G
    return
end

    
0:A&:V& #aa
0:B&:V& #bb

aa aa F
aa bb F
bb aa F
bb bb F



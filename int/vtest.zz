//code (a:Z32;b:Z32->Z32)\ a b + return \   #addcallback
//code (a:Z32;b:Z32->Z32)\ a b * return \   #mulcallback


proc makeCallback:( op:String& ->  callback:(a:Z32;b:Z32->Z32)% )


    code (a:Z32;b:Z32->Z32)\ 
        a b 'op return 
    \ return


end

 
"+" makeCallback #addcallback
"*" makeCallback #mulcallback
 
 
proc useCallback:( a:Z32; b:Z32   ; callback:(a:Z32;b:Z32->Z32)% ->Z32)

    a print  "  " print  b print "  ->    "  print
    a b callback exec return
    
end


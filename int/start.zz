"butt" copy nn.value=
"dog" copy  nn.key=

nn keep zz 0[].next=


virtual HashTable;
selector HashTable.buckets:[pair%]%;


type stringtable
    buckets:[spair%]%;
    virtual htab:HashTable;
end


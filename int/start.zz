proc .hash:(s:String&->N32)
  

    0:N32 #hash
    
    0#i  loop 

        s i[] #c 
        c:Bit while
        
        hash    31 * 
                c:N32 + 
                        hash=
        i&++
    end 
    hash return
end



//need a hashmap


virtual Hashkey;
selector h proc .hash:(h:Hashkey& -> N32);
selector h proc copy:(h:Hashkey& -> like h @ % );
selector h proc ==:(h:Hashkey& ; h2: like h->Bit);

type String
    //virtual hk:Hashkey;
end

type HashEntry
    key:String%;
    value:any%;
    next:HashEntry%;
end




virtual HashMap;
selector HashMap.buckets:[HashEntry%]%;




virtual VHashEntry;
selector VHashEntry.key:Hashkey;
selector VHashEntry.value:any%;
selector VHashEntry.nexy:VHashEntry%;

virtual VHashMap;
selector VHashMap.buckets:[VHashEntry%];



proc []=:(a:any%; h:HashMap&; key:String&)
    h.buckets :Bit if
        "buckets valid" print newline
    else 
        "buckets nil" print newline
        
        [HashEntry%] 1 new h.buckets = //create buckets
        
        "create " h.buckets.size " buckets" prints newline
        
    end
    
    "hash " key.hash  prints newline

    key.hash  h.buckets.size mod  #bucketNum
    
    //search for existing key
    
    h.buckets bucketNum[] keep #bucket
    
    loop bucket:Bit while
        "check key " key "?=" bucket.key  prints newline
        bucket.key key == if
            "replace item" print newline
            a take bucket.value=
            return
        end
        bucket.next keep bucket=
    end
    //not found, make new entry
    
    HashEntry new #entry
    key copy entry.key=
    a take entry.value=
    h.buckets bucketNum[] take entry.next=
    entry take h.buckets bucketNum[]=
end

proc []:(h:HashMap&; key:String& ->any%)
 h.buckets not :Bit if
    "nil buckets" print newline
    0:any% return
 end
 
 key.hash  h.buckets.size mod  #bucketNum
 
 h.buckets bucketNum[] keep #bucket
 loop bucket:Bit while
    "check key " key "?=" bucket.key  prints newline
    bucket.key key == if
        bucket.value keep return
    end
    bucket.next keep bucket=
 end

 0:any% return
 
end



proc isArray:(t:Type&->Bit)  
	t if 
		t.category 	ARRAYDYNAMIC == if
			true return
		end
		t.category ARRAYSTATIC == if
			true return
		end
		
	end
	false return
end

proc isStruct:(t:Type&->Bit)  
	t if 
		t.category 	STRUCT == if
			true return
		end
	end
	false return
end

proc isProc:(t:Type&->Bit)  
	t if 
		t.category 	FUNCTION == if
			true return
		end
	end
	false return
end

proc isReference:(t:Type&->Bit)  
	t if 
		t.category 	POINTERUSER == if
			true return
		end
	end
	false return
end

proc isPossessive:(t:Type&->Bit)  
	t if 
		t.category 	POINTERPOSSESSIVE == if
			true return
		end
	end
	false return
end

proc isCpointer:(t:Type&->Bit)  
	t if 
		t.category 	CPOINTER == if
			true return
		end
	end
	false return
end

proc isPointer:(t:Type&->Bit)  
	t if 
		t.category 	POINTERUSER == if
			true return
		end
		t.category POINTERPOSSESSIVE == if
			true return
		end
		t.category CPOINTER == if
			true return
		end
		
	end
	false return
end

proc .&:(t:Type&->Type&)
	POINTERUSER t 0:String& 0 findType return
end

proc .%:(t:Type&->Type&)
	POINTERPOSSESSIVE t 0:String& 0 findType return
end

proc .array:(t:Type&->Type&)
	ARRAYDYNAMIC t 0:String& 0 findType return
end

proc .array:(t:Type&;n:Z32->Type&)
	ARRAYSTATIC t 0:String& n findType return
end


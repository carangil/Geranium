proc Indent:(level:N32)
	var i:Z32;
	newline 0i= loop  i level < while    "   " print 

	i 1 + i =  
	end
	
	
	"~>|_#$*~>|_#$*" level[] print
	" " print
end


proc xprint:(t:Type&)
	" " print t 0:Bit 0:Bit printTypeNoRedirect

end


proto print:(t:Type&);

primitive C_ptrequal ==:(a:Type&; b:Type& -> Bit);






proto disassemble:(ti:ExecToken;level:N32);

proc disassemble:(ti:ExecToken)
	ti 0 disassemble newline
	
end

proc disassemble:(ti:ExecToken; level:N32)

	ti #t
	0 #count
		
	t.prim "condblock"  == if
		newline level Indent
		"IF:" print 
		t.sub level 1+ disassemble					
	end
		
		
	loop t:Bit while
		count&++
		
		
		
		t.sub:Bit if
				 t.sub level 1+ disassemble 
		end
		
		level Indent
		
		t.prim :Bit if
			t.prim print
			"	" print
		end

		t.text print
		"	" print
		
		"(" print
		
		t.consttype if
			 
			t.value :Z32 print
			" " print
			t.consttype print
			 
		end
		
		
		t.symbol.type print
		")" print
	
		t.evaltype if
			"->" print
			t.evaltype print
		end
			
		t.next t=
	
	end
	
	count return

end


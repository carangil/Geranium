"base/base.zz" include
"base/repl.zz" include

//sys_Repl& .tokens null disassemble

//"gfxgl.zz" include


proc isPrime:(n:N32->Bit)

    n 1 <= if
        false return
    end

    2 #i loop
    
      i i *  n >= until
       
       n i mod:Bit not if
            false return
       end
        
       i&++
       
    end

    true return
end


//isPrime&.tokens 0 null disassemble 

primitive C_firsttoken .tokens:(c:Code%->SourceToken%);

primitive parse sys_Parse:();
primitive parse 1 sys_Parse1:();


0 #i

i 3 + i= loopstep i 50 < while
    i print newline
    
    i 15 == if
        skip
    end
    
    "aa"print newline


end



sys_Repl


proc  GetFromBucket:(  pi:pair% ; k:String& -> like pi.value )
  
  pi take #p
  
    
  "looking for " k prints newline
  
  loop
    
    p:Bit while
    
    "-" p.key prints newline
    
    p.key k == if
        "match" print newline
        p.value keep return
    else
        "continue" print newline
    end
       
    
    
    p.next keep p=
  
  end
  
  null return
  
end


proc  PutInBucket:(   v: like pi.value;    pi:pair% ; k:String& -> like pi )
  
  pi keep #p
  
    v printptr
    v typeof "================" prints newline
    
  "looking for " k "to insert" prints newline
  
  loop
    
    p:Bit while
    
    " see " p.key prints newline
    
    p.key k == if
        "match.. time to write" print newline
        
        v take p.value =
        
        pi take return
        
        
    else
        "continue" print newline
    end
           
    
    p.next keep p=
  
  end
  
  pi dtypeof new p=
  
  p:any& printptr
  
  "p.next&" print
  p.next&  :any& printptr newline
  
  "p.next" print
 ~ p.next  :any& printptr newline
    
  "set v value" print newline
  v take p.value= 
 
  k copy p.key=
 
 
  "p is " print
  p:any& printptr newline
  
  "p.next" print
  p.next  any& printptr newline
  
  
 
  pi
  take
  p.next
  =
  
  "not in bucket: todo insert " k     prints newline
  
  p take return
  
  
  
  //pi dtypeof new
  
  //pi typeof " "  pi dtypeof print newline
  
  
  
end








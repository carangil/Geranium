type LL
	head:LN%;
	tail:LN%;
	
end


type LN
	next:LN%;
	prev:LN%;
	name:String%;
end



proc destructor:(a:LL&)	
	a.head take #ln			//no ref count update
	loop ln:Bit while
		ln.prev take trash
		ln.next take ln=
	end
end

"whatever" Strdup #str0
str0  Strdup #str2



/*
ln:L2

LL
	head	
	tail	


L0
	next: prev:
L1 
	next: prev:
	
L2  prev:







LL
	head	L0
	tail	L2


L0
	next:L1 prev:
L1 
	next:L2 prev:L0
	
L2  prev:L1

*/

proc newLN:(a:String&->LN%)
	LN new #ln
	a strdup ln.name=
	ln take return
end

LL& destructor&:ExecToken disassemble

"LL0" newLN #l0
"LL1" newLN #l1
"LL2" newLN #l2

l1 keep l0.next=
l2 keep l1.next=

l0 keep l1.prev=
l1 keep l2.prev=

LL new #list
l0 take list.head=
l2 take list.tail=
l1 take trash







virtual Hashable;
selector h proc .hash:(h:Hashable& -> N32);
selector h proc copy:(h:Hashable& -> like h @ % );
selector h proc ==:(h:Hashable& ; h2: like h->Bit);

type String             //if a type already exists, it can be extended, but only
    virtual h:Hashable;
end


virtual HashEntry;
selector HashEntry.next:HashEntry%;
selector HashEntry.key:Hashable%;
selector HashEntry.value:any%;



virtual HashMap;
selector HashMap.buckets:[HashEntry%];




type StringToString
    key:    String%;
    value:  String%;
    next:   StringToString%;
    
    virtual h:HashEntry;
end



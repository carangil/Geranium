"base/base.zz" include
"base/repl.zz" include

sys_Repl& .tokens null disassemble


proc isPrime:(n:N32->Bit)

    n 1 <= if
        false return
    end

    2 #i loop
    
      i n == until
       
       n i mod:Bit not if
            false return
       end
        
       i&++
       
    end

    true return
end



0 #i loop
    
    i isPrime if
        i  " " prints
    end
    i&++
    i 1000 >= until
end




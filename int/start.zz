ty 10 .array print newline


proc print:(t:Type&)
	t:Bit not if return end
	
	t.name if
		 t.name print
	end			
	
	t isProc if
		"(" print
		
		0#i loop t i[] ##arg:Bit while
			arg.name print
			":" print
			t.ref print
			";"print
			
			i&++
		end
		
		"->" print
		t.ref print
		")" print
		
	t isArray elseif
		"["print
		t.ref print
		t.len:Bit if
			" " print t.len print
		end
		"]"print
	
	
	t isPossessive elseif
		t.ref print
		"%" print
	
	
	t isCpointer elseif
		t.ref print
		" cpointer" print
	
	
	t isReference elseif
		t.ref print
		"&" print
	end
	
	
end


proc immediate prints:(a:Empty)
	
end

proc immediate prints:(code a:any->Code%)
	code \
		prints 'a print 
	\ return	
end



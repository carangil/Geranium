//"gfxgl.zz" include


proc isPrime:(n:N32->Bit)

    n 1 <= if
        false return
    end

    2 #i i&++ loopstep
    
      i i *  n > until
       
       n i mod:Bit not if
            false return
       end
        
    end

    true return
end


//isPrime&.tokens 0 null disassemble 

primitive C_firsttoken .tokens:(c:Code%->SourceToken%);

primitive parse sys_Parse:();
primitive parse 1 sys_Parse1:();

opaque  ParseMarker;
primitive parsemarker sys_ParseMarker:(->ParseMarker%);

1 #i



i&++ loopstep i 1000 < while
    
    i isPrime if
        i " " prints
    end


end


//SourceToken_C8 String_C2 Z32 Type_C2 Type_C2_C23

primitive  fold  sys_TreeInstruction:(first: ParseMarker% ; b:String&; c:Z32; d:Type&; e:Type&);



//sys_AssembleInstruction typeof print newline newline

proc immediate sys_Instruction:(code first:ParseMarker% ;code primname:String&;code tokval:any; code rettype:Type& )
    
  code \
   'first
   'primname
   'tokval
   'tokval typeof
   'rettype
   
    sys_TreeInstruction
      
      \ insert
      
end


proc immediate addn:()

        sys_ParseMarker #h
        
        h.text "<< start here" prints newline 
        
        sys_Parse 
        
        h take "add32" 0 Z32 N32 sys_TreeInstruction

   //     h take "add32" 0  N32 sys_Instruction

    
end




proc immediate LOOP:()
        
    sys_ParseMarker #h        
    sys_Parse  
        
    h take "loop" 0 null null sys_TreeInstruction
     
end


proc F1:()

       
    LOOP

        "boo " 123 " " 123.4 printsln

    end

    
end


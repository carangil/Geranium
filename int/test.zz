proc ff:(a:Z32->Z32)
   
   var x:Z32;
   
   "start ff " print newline
   
   1  a == if
        "1 case - return " print newline
        0 return
    end
   
   33 x=
   
    proc gg:(b:Z32->Z32)  //can next helper functions
        
        b 10 == if 
            "gg 10 case --return 3 " print newline
            3 return 
        end
        
      
      
        10 gg
      
        "in gg " print newline
         1 ff
        b 10 + return
    end

    
    a 10 + gg #z
        "end ff " print newline
    z return
    
end




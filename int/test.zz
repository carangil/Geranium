virtual Sequence;

selector seq Next:(seq:Sequence& -> Z32);


type Counter
    val:Z32;
    s:Sequence;
end

type Exp
    v:Z32;
    s:Sequence;
end

var c:Counter;
var e:Exp;


[Z32] 20 new0 #n0


proc Next:(c:Counter&->Z32)
    c.val #a
    c.val&++
    a return
end


proc Next:(e:Exp&->Z32)
    e.v 0 == if
        1 e.v =
    end
    e.v #a
    e.v 3*e.v=
    a return
end



[Sequence%] 2 new  #seqs



Counter new :Sequence% seqs 0[]=
Exp new :Sequence% seqs 1[]=

0 #s loop
    0 i= loop
        "Sequence " print s print " i=" print i print "  " print
        seqs s [] Next print newline
        i&++
        i 10 > if break end
    end
    "increment " print newline
    s&++
    s print "  " s 2 >= print newline
    s 2 >= if break end
    
end





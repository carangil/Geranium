 22 b:TestInterface&  F print newline
 
 
 
 proc UseInterface:(v:TestInterface& ->)
    "using interface passed in to function " print newline
    10 v F print newline
    return
 
 end
 
 
 //cast a struct to an interface, and then call a function that accepts an interface

proc mkBoo:(s:String& -> Boo%)
    Boo new #b
    s strdup #scopy
    
    scopy  b.s=
    b take return
end


[TestInterface%] 5 new #ifacesp

    A new  :TestInterface%  ifacesp 0[]=

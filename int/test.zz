"base/base.zz" include


virtual TestInterface;

selector t F:(a:Z32; t:TestInterface&    -> Z32);
selector a G:(a:TestInterface&  ; b:Z32  -> N8);
selector t F:(a:Z32; t:TestInterface%    -> Z32);


type A
    aselectors:TestInterface;
    a:Z32;
    b:Z32;
end

type Boo
    s:String&;
    x:TestInterface;
end

var b:Boo;
var a:A;

newline "boo" print newline




proc G:(aa:A& ; b:Z32->N8)
    "G on A" print newline
    b 65 +:N8 return
end


proc F:(b:Z32; aa:A&->Z32)
    "F on A " print 
    aa.a print newline
    3 b + return
end


proc F:(b:Z32; aa:A%->Z32)
    "F on A (possessive version)" print 
    aa.a print newline
    3 b + return
end


proc G:(aa:Boo& ; b:Z32->N8)
    "G on Boo" print newline
    b 65 +:N8 return
end


proc F:(b:Z32; aa:Boo&->Z32)
    "F on Boo " print 
    aa.s print newline
    30 b + return
end

proc F:(b:Z32; aa:Boo%->Z32)
    "F on Boo (possessive version)" print 
    aa.s print newline
    30 b + return
end




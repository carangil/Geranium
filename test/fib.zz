primitive add32		+:(a:Z32; b:Z32	>> Z32);
primitive load32	@:(a:Z32& 	>> Z32);
primitive store32	=:(v:Z32; a:Z32&>> );
primitive printchar print:(a:N8 >>);
primitive print32   print:(a:Z32 >>);



proc newline:(>>)
	10 :N8 print
	return
end

//This tests recursion and nested if statements, without needing comparisons or iteration implemented

proc fib:(n:Z32 >> Z32)

	n -1 + if
	
	
		n -2 + if
			n -1 +  fib 
			n -2 +  fib + return 
		else
		
			1 return
		end
	
	else
		1 return
	end


end

1 fib print newline
2 fib print newline
3 fib print newline
4 fib print newline
5 fib print newline
6 fib print newline
7 fib print newline
8 fib print newline
9 fib print newline
10 fib print newline



primitive add32		+:(a:Z32; b:Z32	>> Z32);
primitive load32	@:(a:Z32* 	>> Z32);
primitive store32	=:(v:Z32; a:Z32*>> );

//This tests recursion and nested if statements, without needing comparisons or iteration implemented

proc fib:(n:Z32 >> Z32)

	n -1 + if
	
	
		n -2 + if
			n -1 +  fib 
			n -2 +  fib + return 
		else
		
			1 return
		end
	
	else
		1 return
	end


end

1 fib

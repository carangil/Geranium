proc print:(s:String&->)

	0 #i
	loop
		s i[] :Z32 0 == if
			return
		end
		s i[] print
		i 1+ i=
	end

end


proc strlen:(s:String&->Z32)
	0 #i
	loop
		s i[] :Z32 0 == if
			i return
		end
		i 1+ i=
	end
end


proc strcpy:(d:String&;  s:String&->)
	0 #i
	loop
		s i[] d i[]=
		s i[] :Z32 0 == if
			return
		end
		i 1+ i=
	end
end

proc strdup:(s:String&->String%)

	s strlen #le
	
	[N8] le 1 + new :String% #ns
	
	
	ns s strcpy
	
	
	ns take return
end


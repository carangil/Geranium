// a section organizes variables and procedures into a namespace
// it is a way to organize would-be global variables
// the alternative to define a type, and then create a single instance of that type

section stuff

    Z32 var doexit

    (glfw.window*:w Z32:key Z32:scancode Z32:action Z32:mods)& proc keycallback

        key print

       " " print

        scancode print

        10 printchar
    end
end


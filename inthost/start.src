(Any.Instruction: c Z32:indent)   proc disassemble     //function is passed the instruction tree for a Z32

    (Z32:indent) proc tab


        0 var i= loop i indent == if break end
            "    " print
        step
            i 1+i=
        end
    end


   // indent indentnewline

    c.args.count 0 > if
    //  indent indentnewline
      //"{" print

        0 var i=
        loop

            i c.args.count == if
                break
            end

           c.args i[] indent 1+ disassemble

            step
            i 1+ i=
        end


    end

    newline
        indent tab
    c.opname print " " print


    c.valTypeOf Z32 == if
        c.valZ32 print

    c.valTypeOf String == elseif

        "'" print
        c.valString print
        "'" print

    c.valTypeOf? elseif

        c.valTypeOf.key print

    end


     c.return?if
            "  (->" print
            c.return.key print
            ")" print
    end





end



(Any.Instruction$: cd)   proc disassemble
    cd 0 disassemble
end


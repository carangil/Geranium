//shaders
String$ var log


"#version 430 core"
"
layout(location = 0) in vec4 position;

#ifdef OPT_color
    layout(location = 1) in vec4 color;
#endif

#ifdef OPT_cats
    layout(location = 0) uniform vec4 co;
#endif



        out vec4 vf_color;

        void main(){

            gl_Position = position;

        #ifdef OPT_color
            vec4 c  = color;
        #else
            vec4 c = vec4(1.0,0.0,1.0,1.0);
        #endif


        #ifdef OPT_cats
            c = c + co;
        #endif

        vf_color = c;
        }
    "

    "

        out vec4 color;

        in vec4 vf_color;

        void main(){

            color = vf_color;  vec4(1.0,0.0,0.0,1.0);
        }
    "
"color,usechickens,cats"


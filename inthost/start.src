600 400 "TEST" v v glfwCreateWindow w&=
w glfwMakeContextCurrent

1.0 0.5 0.0 1.0 glClearColor

keycallback printptr
w printptr


w keycallback glfwSetKeyCallback


"window " print
w printptr

loop

    glfwPollEvents

    16384 glClear

    4 glBegin
        1.0 0.0 0.0 1.0 glColor4f

        1.0 0.0 -1.0  glVertex3f

        0.0 1.0 0.0 1.0 glColor4f
        0.0 0.5 -1.0  glVertex3f


        0.0 0.0 1.0 1.0 glColor4f
        0.5 0.5 -1.0  glVertex3f

    glEnd

    w glfwSwapBuffers

    doexit if
        break
    end

end



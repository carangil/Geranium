    glfw.PollEvents
    win glfw.WindowShouldClose if
        break
    end
    stuff.doexit if
        break
    end

    Z32 var w
    Z32 var h

    win w& h& glfw.GetFramebufferSize

    0 0 w h gl.Viewport


    1.0 0.5 0.25 1.0 gl.ClearColor

    gl.COLOR_BUFFER_BIT gl.Clear

    gl.TRIANGLES 0 3  gl.DrawArrays



    pos  zgl.BindUpdateArray

    pos 1[].y  .01+ pos 1[].y=

    pos.cptr zgl.Dirty

    win glfw.SwapBuffers
end




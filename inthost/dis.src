//try writing a 'shader' to disassemble


type Vec4
    Real var x
    Real var y
    Real var z
    Real var w
end

(Vec4:a Vec4:b -> Vec4) proto +

(Vec4:v) proto Rasterize



([Vec4]~:position [Vec4]~:color ) proc vshader

    position position + Rasterize
    // 0.1 0.1 0.1 0.0 .Vec4 + Rasterize

end



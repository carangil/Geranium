([Z32]:a) proc print

    0:i loop i a.count < not if break end
        a i[] print " "print
        step i&++
    end
end

([[Z32]$]:a) proc print

    0:i loop i a.count < not if break end
        a i[] print " "print
        step i&++
    end
end



([String$]:a) proc print

    0:i loop i a.count < not if break end
        a i[] print " "print
        step i&++
    end
end


type bar
    Z32 var j
    Z32 var k
end

type foo
    Z32 var n
    String$ var s

    bar var bb
end

([foo]:a) proc print
    0:i loop i a.count < not if break end
        a i[].n print  " " a i[].s print " "print

        a i[].bb.j print "-" print a i[].bb.k print newline
        step i&++
    end

end



([Any] : a ) proc lenof

    "array:" print


    a .count print

    "/" print
    a.size print
    " " print
    a.elemtype.key print
    " each " print
    a.size1 print


end


([Any]$&:a  Z32:extra) proc reserve
    "---"print
    a? not if

        "Cannot reserve from null array, because it has no type information" print newline
        return
    end

    a.elemtype .key print newline
    a.count extra + :need   //how many elements does user need?

    need a.size > if    //if need more than the current size

        //if doubleing more than covers, we will double to amortize growth like a vector
        need  a.size 2*  <  if
            a.size 2* need=
        end

        a& -1 need dim  //resize array

    else
        "OK size" print newline
    end

end



